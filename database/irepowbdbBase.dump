--
-- Name: func_mst_user_trigger(); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.func_mst_user_trigger() RETURNS trigger
    LANGUAGE plpgsql
    AS $$
    DECLARE
    LOG_ID    TEXT;
    LOG_TYPE  TEXT;

    SETTING_LOG_MODE       NUMERIC(1) := 0;
    SETTING_IMAGE_DATA     NUMERIC(1) := 0;
    SETTING_BINARY_DATA    NUMERIC(1) := 0;
    SETTING_OTHER_DATA     NUMERIC(1) := 0;
    BEGIN

    --******************************************
    -- ログ設定テーブルより設定値を取得
    --******************************************
    SELECT COALESCE(log.log_mode, 0)
    ,COALESCE(log.image_data, 0)
    ,COALESCE(log.binary_data, 0)
    ,COALESCE(log.other_data, 0)
    INTO  SETTING_LOG_MODE
    ,SETTING_IMAGE_DATA
    ,SETTING_BINARY_DATA
    ,SETTING_OTHER_DATA
    FROM  mst_logsetting log
    WHERE log.table_name = TG_RELNAME
    AND log.log_type = TG_OP;

    -- なければデフォルト値
    IF NOT FOUND THEN
    SETTING_LOG_MODE = 0;
    SETTING_IMAGE_DATA = 0;
    SETTING_BINARY_DATA = 0;
    SETTING_OTHER_DATA = 0;
    END IF;

    -- 出力判定
    IF SETTING_LOG_MODE <> 1 THEN
    RETURN NEW;
    END IF;



    LOG_ID = TO_CHAR(NOW(), 'YYYYMMDDHH24MISS') || NEXTVAL('LOG_MST_USER_SEQ');

    IF TG_OP = 'INSERT' THEN
    LOG_TYPE = 'I';
    ELSIF TG_OP = 'UPDATE' THEN
    LOG_TYPE = 'U';
    ELSIF TG_OP = 'DELETE' THEN
    LOG_TYPE = 'D';
    END IF;

    IF TG_OP = 'INSERT' OR
    TG_OP = 'UPDATE' THEN
    INSERT INTO LOG_MST_USER
    (
    LOG_ID
    ,LOG_TYPE
    ,USER_ID
    ,PASSWORD
    ,USER_NAME
    ,E_MAIL
    ,APPROVAL_SIGN
    ,USE_START_TIME
    ,USE_END_TIME
    ,SYS_REGIST_TERM
    ,SYS_REGIST_USER
    ,SYS_REGIST_TIME
    ,SYS_UPDATE_TERM
    ,SYS_UPDATE_USER
    ,SYS_UPDATE_TIME
    ) VALUES (
    LOG_ID
    ,LOG_TYPE
    ,NEW.USER_ID
    ,NEW.PASSWORD
    ,NEW.USER_NAME
    ,NEW.E_MAIL
    ,CASE WHEN SETTING_IMAGE_DATA = 1 THEN NEW.APPROVAL_SIGN END
    ,NEW.USE_START_TIME
    ,NEW.USE_END_TIME
    ,NEW.SYS_REGIST_TERM
    ,NEW.SYS_REGIST_USER
    ,NEW.SYS_REGIST_TIME
    ,NEW.SYS_UPDATE_TERM
    ,NEW.SYS_UPDATE_USER
    ,NEW.SYS_UPDATE_TIME
    );
    RETURN NEW;
    ELSE
    INSERT INTO LOG_MST_USER
    (
    LOG_ID
    ,LOG_TYPE
    ,USER_ID
    ,PASSWORD
    ,USER_NAME
    ,E_MAIL
    ,APPROVAL_SIGN
    ,USE_START_TIME
    ,USE_END_TIME
    ,SYS_REGIST_TERM
    ,SYS_REGIST_USER
    ,SYS_REGIST_TIME
    ,SYS_UPDATE_TERM
    ,SYS_UPDATE_USER
    ,SYS_UPDATE_TIME
    ) VALUES (
    LOG_ID
    ,LOG_TYPE
    ,OLD.USER_ID
    ,OLD.PASSWORD
    ,OLD.USER_NAME
    ,OLD.E_MAIL
    ,CASE WHEN SETTING_IMAGE_DATA = 1 THEN OLD.APPROVAL_SIGN END
    ,OLD.USE_START_TIME
    ,OLD.USE_END_TIME
    ,OLD.SYS_REGIST_TERM
    ,OLD.SYS_REGIST_USER
    ,OLD.SYS_REGIST_TIME
    ,OLD.SYS_UPDATE_TERM
    ,OLD.SYS_UPDATE_USER
    ,OLD.SYS_UPDATE_TIME
    );
    RETURN OLD;
    END IF;

    END;
    $$;


ALTER FUNCTION public.func_mst_user_trigger() OWNER TO postgres;

