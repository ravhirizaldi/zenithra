{
  "name": "conmas-node",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "dev": "node --watch --watch-preserve-output --import tsx src/server.ts",
    "build": "tsc",
    "import:samples": "tsx src/import-samples.ts",
    "db:prepare": "tsx src/prepare-database.ts",
    "start": "node dist/server.js",
    "test": "tsx --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "lint": "eslint src test eslint.config.mjs",
    "lint:fix": "eslint src test eslint.config.mjs --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@pdf-lib/fontkit": "1.1.1",
    "blessed": "^0.1.81",
    "dotenv": "^18.0.9",
    "ejs": "^3.1.10",
    "express": "^5.1.0",
    "express-session": "^1.19.0",
    "fast-xml-parser": "^5.12.0",
    "multer": "^2.5.0",
    "nodemailer": "^10.3.1",
    "pdf-lib": "1.17.1",
    "pg": "^8.23.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/blessed": "^0.1.27",
    "@types/ejs": "^3.1.5",
    "@types/express": "^5.0.3",
    "@types/express-session": "^1.19.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "playwright-core": "^1.65.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.72.1"
  }
}
