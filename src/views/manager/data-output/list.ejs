<% const ui = managerResources["data-output"]; %><div class="manager-output-paging"><select name="CheckedStateValue" aria-label="<%= ui["Selected state"] %>" onchange="outputPage(0)"><% for(const [key,title] of [['-1',ui["Display all"]],['0',ui["Display checks only"]],['1',ui["Display except checks"]]]) { %><option value="<%= key %>" <%= String(input.CheckedStateValue || '-1') === key ? 'selected' : '' %>><%= title %></option><% } %></select><%- include('../shared/transfer-paging', { pageFunction: 'outputPage' }) %></div>
<input type="hidden" name="PageIndex" id="PageIndex" value="<%= list.index %>"><input type="hidden" name="SortColumn" id="SortColumn" value="<%= list.order %>"><input type="hidden" name="SortDirection" id="SortDirection" value="<%= list.direction %>">
<div id="GridSection" class="manager-grid-scroll" tabindex="0" role="region" aria-label="<%= kind === 'def' ? 'Forms' : 'Documents' %>"><table class="GridCommon manager-output-grid" cellspacing="1" id="<%= kind === 'def' ? 'DefReportList' : 'RepReportList' %>"><tr><th class="checkCol"><input type="checkbox" aria-label="<%= ui["Select page"] %>" onclick="$('.output-select').prop('checked',this.checked)"></th><% for(const [key,title,width] of [[kind+'_top_id','ID',45],[kind+'_top_name','Form name',0],[kind+'_top_org','Original ID',45],['rev_no',ui["REV"],45],['sys_regist_time',ui["Registration date and time"],100],['sys_regist_user',ui["Registrant"],80],['sys_update_time',ui["Last update date and time"],100],['sys_update_user',ui["Last updated by"],80]]) { %><th scope="col" style="<%= width ? `width:${width}px;` : '' %>" class="<%= list.order === key ? 'sorting' : '' %>"><span><%= title %></span><a class="sort <%= list.order === key ? list.direction === 'ASC' ? 'asc' : 'desc' : '' %>" aria-label="<%= ui["Sort"] %> <%= title %>" href="#" onclick="outputSort('<%= key %>');return false;"><%= ui["sort"] %></a></th><% } %></tr>
<% for(const [i,row] of list.rows.entries()) { %><tr class="<%= row.is_current === false ? 'history' : i%2===0 ? 'odd' : 'even' %>"><td class="checkCol"><input type="checkbox" class="output-select" value="<%= row.id %>" aria-label="<%= ui["Select"] %> <%= row.name %>" <%= (kind==='def'?selection.definitions:selection.reports).includes(row.id) ? 'checked' : '' %>></td><td class="CenterCol"><%= row.id %></td><td><span class="docTitle"><a href="<%= base %>/DataOutput/DetailInfo?topId=<%= row.id %>&mode=<%= kind %>"><%= row.name || '..' %></a></span></td><td class="CenterCol"><%= row.org %></td><td class="CenterCol"><%= row.rev_no %></td><td class="CenterCol"><%= row.sys_regist_time ? new Date(row.sys_regist_time).toISOString().slice(0,16).replace('T',' ').replaceAll('-','/') : '' %></td><td class="CenterCol"><%= row.created_by %></td><td class="CenterCol"><%= row.sys_update_time ? new Date(row.sys_update_time).toISOString().slice(0,16).replace('T',' ').replaceAll('-','/') : '' %></td><td class="CenterCol"><%= row.updated_by %></td></tr><% } %></table></div>
