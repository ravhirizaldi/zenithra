<% const ui = managerResources["documents"]; %><script src="<%= base %>/Scripts/jquery.validate.min.js" type="text/javascript"></script>
<script src="<%= base %>/Scripts/jquery.validate.unobtrusive.min.js" type="text/javascript"></script>
<script type="text/javascript"><%- js %></script>
<div class="PartialViewMessage"><% if (error) { %><ul role="alert"><li><%= error %></li></ul><% } %></div>
<div id="DetailTop"><span id="infoTitle"><%= r.rep_top_name %>:<%= report.rep_top_name %></span></div>
<div id="DetailSection"><div class="info"><%= v.labelSetting %>:
  <form id="form0" action="<%= base %>/DefReport/EditLabel" method="post" data-ajax="true" data-ajax-update="#content" data-ajax-failure="fConMasDocumentFailure">
    <input type="hidden" name="__RequestVerificationToken" value="<%= csrfToken %>">
    <input type="hidden" id="def_top_id" name="def_top_id" value="<%= report.rep_top_id %>">
    <input type="hidden" id="mode" name="mode" value="Rep">
    <input type="hidden" id="ActionCommonType" name="ActionCommonType" value="">
    <input type="hidden" id="SaveLabelId" name="SaveLabelId" value="">
    <input type="hidden" id="IsSaveLabelType" name="IsSaveLabelType" value="false">
    <input type="hidden" id="PageIndex" name="PageIndex" value="<%= index %>">
    <input type="hidden" id="IsSearchLock" name="IsSearchLock" value="<%= locked %>">
    <input type="hidden" name="LabelSerach.LabelSearchType" value="0">
    <div class="toggle" onclick="fConMasToggle('searchLabelBox');"><h2 style="margin-top:5px;">▼<%= r.Search %></h2></div>
    <div id="searchLabelBox">
      <div style="padding:3px;"><table cellpadding="0" cellspacing="0" class="table_information horizontal">
        <tr><th scope="row"><label for="LabelSerach_LabelName"><%= r.label_name %></label></th><td>
          <input id="LabelSerach_LabelName" name="LabelSerach.LabelName" value="<%= name %>"<% if (locked) { %> disabled readonly<% } %>>
          <% if (locked) { %><input type="hidden" name="LabelSerach.LabelName" value="<%= name %>"><% } %>
        </td></tr>
        <tr><th scope="row"><%= r.LabelCheckedProparty %></th><td>
          <% for (const value of ['0', '1', '2']) { %><label><input type="radio" name="LabelSerach.LabelCheckedType" value="<%= value %>"<% if (value === checkedType) { %> checked<% } %><% if (locked) { %> disabled<% } %>> <%= r['LabelChecked' + value] %></label><% } %>
          <% if (locked) { %><input type="hidden" name="LabelSerach.LabelCheckedType" value="<%= checkedType %>"><% } %>
        </td></tr>
      </table></div>
      <div style="padding:3px;"><input type="submit" class="<%= locked ? 'image-cancel_btn' : 'image-ok_btn' %>" value="<%= locked ? r.SearchCancel : r.Search %>" onclick="fConMasLabelSubmitAction('<%= locked ? 'CancelType' : 'SearchType' %>');"></div>
    </div>
    <%- include('settings-paging', { kind: 'labels', bottom: false }) %>
    <div class="toggle" onclick="fConMasToggle('label');"><h2 style="margin-top:5px;">▼<%= r.ConMasResource_Label.replace('{0}', '') %></h2></div>
    <div id="label">
      <p><% if (total > 0) { %><input type="submit" class="image-ok_btn" value="<%= r.Fix %>" onclick="fConMasLabelSubmitAction('SaveType');"><% } %> <input type="submit" class="image-cancel_btn" value="<%= r.Cancel %>" onclick="saveCancel();"></p>
      <table cellpadding="0" cellspacing="0" class="table_information verticality">
        <tr><th scope="col"><%= v.labelField %></th><th scope="col"><%= v.remark %></th></tr>
        <% rows.forEach((row, count) => { %><tr>
          <td><label><input type="checkbox" id="labelsPage_<%= count %>__Chk" value="<%= row.checked %>"<% if (row.checked) { %> checked<% } %> onclick="fConMasLabelSubmitAction('EditType',<%= row.mst_label_id %>,this.checked); return fConMasSubmit();">&nbsp;
            <img src="<%= base %>/Content/ConMas/images/function/label_icon_<%= row.label_icon_id %>.png" class="labelPictureSize" alt="[<%= v.icon %><%= row.label_icon_id %>]"> <%= row.label_name_path %>
          </label></td><td><%= row.label_remarks %></td>
        </tr><% }); %>
      </table>
    </div>
    <%- include('settings-paging', { kind: 'labels', bottom: true }) %>
    <p><% if (total > 0) { %><input type="submit" class="image-ok_btn" value="<%= r.Fix %>" onclick="fConMasLabelSubmitAction('SaveType');"><% } %> <input id="btnCancel" type="submit" class="image-cancel_btn" value="<%= r.Cancel %>" onclick="saveCancel();"><input type="hidden" id="isCanceled" name="isCanceled" value=""></p>
  </form>
</div></div>
