    // 帳票ID選択 ※未使用
    function fConMasSelectRep(repTopId, repTopName) {
        if (repTopName == null) {
            repTopName = "";
        }
        $("#SchData_rep_top_id.rep")[0].value = repTopId;
        $("#SchData_rep_top_name.rep")[0].value = repTopName;
        $("#conmasCloseButton")[0].click();
        $("#lean_overlay")[0].click();
    };

    // タスクIDの選択
    function fConMasSelectTask(taskId, taskName, taskRemark) {
        $("#SchData_task_name")[0].value = taskName;
        $("#SchData_task_remark")[0].value = taskRemark;
        $("#SchData_task_name").attr("readonly", "true");
        $("#SchData_task_remark").attr("readonly", "true");
        $("#SchData_task_id")[0].value = taskId;
        $("#conmasCloseButton")[0].click();
        $("#lean_overlay")[0].click();
    }

    function setSelectedRow() {
        // 選択されていた帳票の行に色をつける
        var selectedRepTopId = localStorage.getItem('selectedRepTopId');
        if (selectedRepTopId != null) {
            var target = $('input[name="Cbx"][value="' + selectedRepTopId + '"]');
            if (target) {
                target.parent().parent().addClass("selected");
            }
            localStorage.removeItem("selectedRepTopId");
        }

        // 保存した位置までスクロール
        var repListScrollTop = localStorage.getItem('repListScrollTop');
        if (repListScrollTop != null) {
            $("#GridSection").scrollTop(repListScrollTop);
            localStorage.removeItem("repListScrollTop");
        }
    }
