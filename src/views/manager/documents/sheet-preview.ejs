<% const ui = managerResources["documents"]; %><% const historic = clusterId !== null;
   const action = historic ? 'DetailsClusterHistory' : edit ? 'EditSheet' : 'DetailsSheet';
   const query = {repTopId: String(report.rep_top_id), pageIndex: String(pageIndex), ...(historic ? {clusterId: String(clusterId)} : {})};
   const link = flags => base + '/InputReport/' + action + '?' + new URLSearchParams({...query, ...flags}).toString();
   const pdf = new URLSearchParams({defTopId: String(report.def_top_id), repTopId: String(report.rep_top_id), sheetNo: String(sheet.rep_sheet_no),
     ...(!edit ? {isLayer: String(isLayer), isInitJudgeDisplay: String(isInitJudgeDisplay)} : {}),
     ...(historic ? {isClusterLine: 'true', clusterId: String(clusterId)} : {})}); %>
<table border="0" cellpadding="0" cellspacing="0" width="100%">
  <tr>
    <td id="previewLeftTop"><br>
      <% if (!edit) { %>
        <div><a href="<%= link({isLayer: String(!isLayer), isInitJudgeDisplay: String(isInitJudgeDisplay)}) %>" class="<%= isLayer ? 'layer_change_On' : 'layer_change' %>" data-ajax="true" data-ajax-update="#content"><%= isLayer ? r.LayerOff : r.LayerOn %></a></div>
        <div><a href="<%= link({isLayer: String(isLayer), isInitJudgeDisplay: String(!isInitJudgeDisplay)}) %>" class="<%= isInitJudgeDisplay ? 'layer_change_On' : 'layer_change' %>" data-ajax="true" data-ajax-update="#content"><%= isInitJudgeDisplay ? r.InitInputJudgeSettingOff : r.InitInputJudgeSettingOn %></a></div>
      <% } %>
    </td>
    <td rowspan="2" id="previewImage"><embed src="<%= base %>/InputReport/GetPdf?<%= pdf %>" type="application/pdf" title="<%= sheet.rep_sheet_name %>" width="100%" height="100%"></td>
    <td id="previewRightTop"><br></td>
  </tr>
  <tr>
    <td id="previewLeftBottom"><% if (!historic) { %><% if (pageIndex > 0) { %><a href="<%= link({pageIndex: String(pageIndex - 1)}) %>" class="img_preview_prev_e" title="<%= ui["Previous"] %>" data-ajax="true" data-ajax-update="#content"> </a><% } else { %><img src="<%= base %>/Content/ConMas/images/detail/preview_prev_d.png" alt="<%= ui["[prev]"] %>"><% } %><% } %></td>
    <td id="previewRightBottom"><% if (!historic) { %><% if (pageIndex + 1 < pages) { %><a href="<%= link({pageIndex: String(pageIndex + 1)}) %>" class="img_preview_next_e" title="<%= ui["Next"] %>" data-ajax="true" data-ajax-update="#content"> </a><% } else { %><img src="<%= base %>/Content/ConMas/images/detail/preview_next_d.png" alt="<%= ui["[next]"] %>"><% } %><% } %></td>
  </tr>
  <tr style="border-style:solid;"><td id="previewFooter" colspan="3"><%= pageIndex + 1 %>/<%= pages %></td></tr>
</table>
