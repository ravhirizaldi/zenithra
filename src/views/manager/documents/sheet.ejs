<script src="<%= base %>/Scripts/jquery.validate.min.js" type="text/javascript"></script>
<script src="<%= base %>/Scripts/jquery.validate.unobtrusive.min.js" type="text/javascript"></script>
<script type="text/javascript"><%- js %></script>
<div class="PartialViewMessage"><% if (error) { %><ul class="validation-summary-errors"><li><%= error %></li></ul><% } %></div>
<div id="DetailTop"><span id="infoTitle"><%= v.reportName %> : <%= report.rep_top_name %></span>
  <% if (!edit) { %><span id="functionBar"><% if (report.workflow_locked || report.locked) { %><label class="user_lock_label"><%= v.locked %>：<%= report.workflow_locked ? report.sys_update_user_name : report.lock_user_name %></label><% } else if (report.applicant_locked) { %><label class="user_lock_label"><%= r.ApplicantLabel %></label><% } else if (report.current && report.role_update && permissions.update && Number(sheet.edit_refer_status) !== 4) { %><a href="<%= base %>/InputReport/EditSheet?repTopId=<%= report.rep_top_id %>&amp;pageIndex=<%= pageIndex %>" class="img_edit" title="<%= v.edit %>" data-ajax="true" data-ajax-update="#content"> </a><% } %></span><% } %>
</div>
<% if (edit) { %><form method="post" action="<%= base %>/InputReport/EditSheet" data-ajax="true" data-ajax-update="#content" data-ajax-failure="fConMasDocumentFailure"><% } %>
  <input type="hidden" name="__RequestVerificationToken" value="<%= csrfToken %>">
  <input type="hidden" name="rep_sheets[0].rep_top_id" value="<%= report.rep_top_id %>"><input type="hidden" name="rep_sheets[0].rep_sheet_id" value="<%= sheet.rep_sheet_id %>"><input type="hidden" name="rep_sheets.PageIndex" value="<%= pageIndex %>">
  <div id="DetailSection"><div class="info">
    <% if (edit) { %><p><button type="submit" class="image-ok_btn"><%= r.Fix %></button> <button type="submit" name="isCanceled" value="1" class="image-cancel_btn"><%= r.Cancel %></button></p><% } %>
    <table cellpadding="0" cellspacing="0" class="table_information horizontal">
      <tr><th scope="row"><%= r.rep_sheet_id %></th><td><%= sheet.rep_sheet_id %></td></tr>
      <tr><th scope="row"><label for="rep_sheets_0__rep_sheet_name"><%= r.rep_sheet_name %></label></th><td><% if (edit) { %><input class="EditValue1" id="rep_sheets_0__rep_sheet_name" name="rep_sheets[0].rep_sheet_name" value="<%= sheet.rep_sheet_name %>" required><% } else { %><%= sheet.rep_sheet_name %><% } %></td></tr>
      <tr><th scope="row"><%= r.rep_sheet_no %></th><td><%= sheet.rep_sheet_no %></td></tr>
      <% if (!edit) { %><tr><th scope="row"><%= r.copy_disable %></th><td><%= Number(sheet.copy_disable) === 1 ? r.SELECTED_AVAILABLE_NO : r.SELECTED_AVAILABLE_YES %></td></tr><% } %>
    </table>
    <%- include('sheet-preview', {clusterId: null}) %>
    <div class="toggle" onclick="fConMasToggle('remarks')"><h2>▼<%= v.remark %></h2></div>
    <div id="remarks"><table cellpadding="0" cellspacing="0" class="table_information horizontal"><% for (let index = 1; index <= 10; index++) { %><tr><th scope="row"><label for="rep_sheets_0__sheet_remarks<%= index %>"><%= sheet['sheet_remarks_name' + index] %></label></th><td><% if (edit) { %><input class="EditValue1" id="rep_sheets_0__sheet_remarks<%= index %>" name="rep_sheets[0].sheet_remarks<%= index %>" value="<%= sheet['sheet_remarks' + index] || '' %>"><% } else { %><%= sheet['sheet_remarks' + index] %><% } %></td></tr><% } %></table></div>
    <% if (!edit) { %><div class="toggle" onclick="fConMasToggle('reference')"><h2>▼<%= r.ReferencesTop10Setting %></h2></div>
    <div id="reference"><div id="references"><table cellpadding="0" cellspacing="0" class="table_information vertical">
      <tr><th scope="col"><%= r.diplay_number %></th><th scope="col"><%= r.reference_name %></th><th scope="col"><%= r.reference_type %></th><th scope="col"><%= r.reference_value %></th></tr>
      <% for (const row of references.slice(0,10)) { %><tr><td><%= row.diplay_number %></td><% if (!row.accessible) { %><td><%= r.SELECTED_ROLE_STATE_REFER_NO %></td><td></td><td></td><% } else { %><td><%= row.reference_name %></td><td><%= row.reference_type %></td><td><% if (row.document_id && row.reference_value) { %><a href="<%= base %>/Library/GetDocument?documentId=<%= row.document_id %>"><%= row.reference_value %></a><% } else { %><%= row.reference_value %><% } %></td><% } %></tr><% } %>
    </table></div></div>
    <% const layerDraws = draws.filter(row => row.type === 'layer'); if (layerDraws.length) { %><div class="toggle" onclick="fConMasToggle('layerImage')"><h2>▼<%= r.rep_layer_draw %></h2></div><div id="layerImage"><table cellpadding="0" cellspacing="0" class="table_information horizontal">
      <% for (let index = 0; index < layerDraws.length; index += 2) { %><tr><% for (const row of layerDraws.slice(index,index + 2)) { const query = new URLSearchParams({repSheetId: String(sheet.rep_sheet_id), layerId: String(row.key_id), imageNo: String(row.image_no), type: 'layer'}); %><td style="text-align:center; width:50%;"><a href="<%= base %>/InputReport/GetLayerDraw?<%= query %>&amp;isResize=false"><%= r.Download %></a><br><img src="<%= base %>/InputReport/GetLayerDraw?<%= query %>&amp;isResize=true" alt="[layer]"></td><% } if (index + 1 === layerDraws.length) { %><td></td><% } %></tr><% } %>
    </table></div><% } %>
    <% if (layers[0]?.input_value) { %><div class="toggle" onclick="fConMasToggle('layerInfo')"><h2>▼<%= r.LayerInputValue %></h2></div><div id="layerInfo"><table cellpadding="0" cellspacing="0" class="table_information horizontal"><% for (const row of layers) { %><tr><td><% if (row.input_value) for (const text of String(row.input_value).split(',')) { %><div><%= text %></div><% } %></td></tr><% } %></table></div><% } %>
    <% } %><div class="toggle" onclick="fConMasToggle('cluster')"><h2>▼<%= r.Cluster %></h2></div>
    <div id="cluster"><table cellpadding="0" cellspacing="0" class="table_information verticality" width="100%">
      <% const hasPin = clusters.some(row => row.cluster_type === 'DrawingImage') && (edit || Number(sheet.is_sort_report) !== 1), changeReason = sheet.show_change_reason;
         if (edit) { %><tr><th scope="col"><%= v.numberAbbreviation %></th><th scope="col"><%= v.clusterName %></th><th scope="col"><%= v.clusterType %><div style="float:right"><img src="<%= base %>/Content/ConMas/images/detail/cluster_setting_image.png" alt="[setting]" class="toggle" onclick="toggle3();"></div></th><% if (hasPin) { %><th style="width:23px;" scope="col">ピン番号</th><% } %><th scope="col"><%= v.inputValue %></th><th scope="col" style="width:60px;"><%= r.VarifiedMessage %></th><% if (changeReason) { %><th scope="col"><div><%= r.change_reason %></div></th><% } %><th scope="col"><%= r.DatabaseResource_comment %></th><th scope="col" class="clusterSetting" style="display:none; width:100px;"><%= v.clusterParameter %></th></tr>
      <% } else { %><tr><th style="width:23px;" scope="col"><%= v.numberAbbreviation %></th><th style="width:80px;" scope="col"><%= r.cluster_name %></th><th style="width:50px;" scope="col"><%= r.cluster_type %><div style="float:right"><img src="<%= base %>/Content/ConMas/images/detail/cluster_setting_image.png" alt="[setting]" class="toggle" onclick="toggle3();"></div></th><% if (hasPin) { %><th style="width:23px;" scope="col">ピン番号</th><% } %><th scope="col"><%= r.display_value %></th><th scope="col"><%= r.DatabaseResource_edit_user %></th><th scope="col"><%= r.DatabaseResource_edit_time %></th><th scope="col"><%= r.DatabaseResource_GPS %></th><th scope="col"><%= r.sys_update_info %></th><th scope="col"><%= r.change_reason %></th><th scope="col"><%= r.DatabaseResource_comment %></th><th scope="col" class="clusterSetting" style="display:none; width:100px;"><%= r.input_parameter %></th></tr><% } %>
      <% clusters.forEach((row, index) => { %><tr>
        <td class="CenterCol"><%= row.cluster_id %></td><td><%= row.cluster_name %></td><td class="CenterCol"><%= row.cluster_type === 'QRCode' ? 'Barcode' : row.cluster_type %></td>
        <% if (hasPin) { %><td><%= row.cluster_role === '2' ? '' : row.pin_value %></td><% } %>
        <td><%- edit ? include('cluster-input', {row,index}) : include('cluster-value', {row: {...row, draws: draws.filter(draw => draw.type === 'cluster' && Number(draw.key_id) === Number(row.cluster_id))}}) %>
          <% if (!edit && row.cluster_role !== '2' && row.history_count > 1) { %><div><a class="conmas_link_button_custom" href="<%= base %>/InputReport/DetailsClusterHistory?repTopId=<%= report.rep_top_id %>&amp;pageIndex=<%= pageIndex %>&amp;clusterId=<%= row.cluster_id %>&amp;isInitJudgeDisplay=<%= isInitJudgeDisplay %>" data-ajax="true" data-ajax-update="#content"><%= r.InputHistory %></a></div><% } %>
        </td>
        <% if (edit) {
          const name = 'rep_clusters[' + index + '].', id = 'rep_clusters_' + index + '__';
          const verify = row.cluster_role === '1' && !['Registration','LatestUpdate','RegistrationDate','LatestUpdateDate','FixedText','FreeDraw'].includes(row.cluster_type);
          const disabled = !(['Approve','Create'].includes(row.cluster_type) || row.cluster_type === 'Inspect' && String(row.input_value) === '0' || row.cluster_type === 'Check' && String(row.input_value).toUpperCase() === 'FALSE' || !row.input_value);
        %><td style="vertical-align:middle; text-align:center;"><div><% if (verify) { %><input type="checkbox" id="<%= id %>Verified" name="<%= name %>Verified" value="true"<% if (Number(row.verified) === 1) { %> checked<% } %><% if (disabled) { %> disabled<% } %> aria-label="<%= row.cluster_name %> (<%= r.VarifiedMessage %>)"><input type="hidden" name="<%= name %>Verified" value="false"><% } else if (row.cluster_role !== '2') { %><input type="hidden" name="<%= name %>Verified" value="<%= Number(row.verified) === 1 ? 'True' : 'False' %>"><% } %></div></td>
          <% if (changeReason) { %><td><% if (row.cluster_role !== '2') { %><div><textarea name="<%= name %>ChangeReason" aria-label="<%= row.cluster_name %> (<%= r.change_reason %>)"><%= row.change_reason || '' %></textarea></div><% } %></td><% } %>
          <td><% if (['Check','MultipleChoiceNumber'].includes(row.cluster_type) && row.cluster_role === '1') { %><textarea name="<%= name %>comment_value" aria-label="<%= row.cluster_name %> (<%= r.DatabaseResource_comment %>)"><%= row.comment_value || '' %></textarea><% } else if (row.cluster_role === '0' && row.input_check_value) { %><%= row.comment_value %><% } %></td>
          <td class="clusterSetting" style="display:none;"><% if (row.cluster_role !== '2') for (const parameter of String(row.input_parameter || '').split(';')) { %><div><%= parameter %></div><% } %></td>
          <input type="hidden" name="<%= name %>cluster_role" value="<%= row.cluster_role %>"><input type="hidden" name="<%= name %>rep_sheet_id" value="<%= row.rep_sheet_id %>"><input type="hidden" name="<%= name %>cluster_id" value="<%= row.cluster_id %>">
        <% } else if (row.cluster_role === '2') { %><td></td><td></td><td></td><td></td><td></td><td></td><td class="clusterSetting" style="display:none;"></td><% } else { %><td><%= row.edit_user ? row.edit_user + ':' + (row.edit_user_name || '') : '' %></td><td><%= row.edit_time %></td><td><%- include('cluster-gps', {row}) %></td><td><% if (row.edit_user && !row.client_updated && row.sys_update_user) { %><div style="color:Red;"><%= row.sys_update_user %>:<%= row.updated_by %></div><% if (row.updated) { %><div style="color:Red;"><%= row.updated %></div><% } } %></td><td><%= row.change_reason %></td><td><%= row.comment_value %></td><td class="clusterSetting" style="display:none;"><% for (const parameter of String(row.input_parameter || '').split(';')) { %><div><%= parameter %></div><% } %></td><% } %>
      </tr><% }); %>
    </table></div>
  </div></div>
<% if (edit) { %></form><% } %>
