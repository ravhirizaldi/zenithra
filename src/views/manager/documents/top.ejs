<script src="<%= base %>/Scripts/jquery.validate.min.js" type="text/javascript"></script>
<script src="<%= base %>/Scripts/jquery.validate.unobtrusive.min.js" type="text/javascript"></script>
<script type="text/javascript"><%- js %></script>
<div class="PartialViewMessage"><% if (error) { %><ul class="validation-summary-errors" role="alert"><li><%= error %></li></ul><% } %></div>
<div id="DetailTop">
  <span id="infoTitle"><%= v.reportName %> : <%= report.rep_top_name %></span>
  <% if (!edit) { %><span id="functionBar">
    <% if (report.workflow_locked || report.locked) { %><label class="user_lock_label"><%= v.locked %>：<%= report.workflow_locked ? report.sys_update_user_name : report.lock_user_name %></label>
    <% } else if (report.applicant_locked) { %><label class="user_lock_label"><%= r.ApplicantLabel %></label>
    <% } else if (permissions.update && report.role_update && report.current) { %><a href="<%= base %>/InputReport/EditTop?repTopId=<%= report.rep_top_id %>" class="img_edit" title="<%= v.edit %>" data-ajax="true" data-ajax-update="#content"> </a><% } %>
  </span><% } %>
</div>
<form id="form0" method="post" action="<%= base %>/InputReport/EditTop" data-ajax="true" data-ajax-update="#content" data-ajax-failure="fConMasDocumentFailure">
  <input type="hidden" name="__RequestVerificationToken" value="<%= csrfToken %>">
  <input type="hidden" id="rep_top_rep_top_id" name="rep_top.rep_top_id" value="<%= report.rep_top_id %>">
  <div id="DetailSection"><div class="info">
    <table border="0" cellpadding="0" cellspacing="0" width="100%"><tr>
      <td id="previewLeftTop">
        <% if (!report.current) { %><div id="HistoryInfo"><label id="HistoryLabel" class="historyMark"><%= r.History %></label></div><% } %>
        <div id="PublicStatus"><label class="<%= ['privateStatus','testStatus','publicStatus'][Number(report.public_status)] || '' %>"><%= [r.NonDisclosure,r.Test,r.Published][Number(report.public_status)] || '' %></label></div>
        <div id="EditReferStatus"><label class="edit_refer_status"><img src="<%= base %>/Content/ConMas/images/grid/grid_status_<%= Number(report.edit_refer_status) + 1 %>.png" alt="[edit]"><%= [v.edit0,v.edit1,v.edit2,v.topEdit3,v.edit4][Number(report.edit_refer_status)] || '' %></label></div>
      </td>
      <td id="previewImage"><embed src="<%= base %>/InputReport/GetPdf?defTopId=<%= report.def_top_id %>&amp;repTopId=<%= report.rep_top_id %>" type="application/pdf" title="<%= v.basicInformation %>" width="100%" height="100%"></td>
    </tr></table>
    <% if (edit) { %><p>
      <button type="submit" class="image-ok_btn" onclick="editOutputFileChecked();"><%= r.Fix %></button>
      <button type="submit" class="image-cancel_btn" name="isCanceled" value="1"><%= r.Cancel %></button>
    </p><% } %>
    <div class="toggle" onclick="fConMasToggle('topInfo')"><h2>▼<%= v.basicInformation %></h2></div>
    <div id="topInfo"><table cellpadding="0" cellspacing="0" class="table_information horizontal">
      <tr><th scope="row"><%= r.rep_top_id %></th><td><%= report.rep_top_id %></td></tr>
      <% for (const item of fields.filter(item => !item.name.startsWith('top_remarks') && !item.name.startsWith('system_key'))) { %>
        <tr><th scope="row"><label for="rep_top_<%= item.name %>"><%= r[item.label] || v[item.label] || item.label %></label></th><td>
          <% if (edit && item.editable) { %>
            <% if (['output_setting','edit_output_setting','PdfAutoOutputSheetSelect'].includes(item.name)) { %>
              <% item.options.forEach((text, index) => { %><label><input type="radio" id="rep_top_<%= item.name %><%= index ? '_' + index : '' %>" name="rep_top.<%= item.name %>" value="<%= index %>" <%= item.value === String(index) ? 'checked' : '' %> onclick="<%= item.name === 'output_setting' ? 'outputSettingSelect(false)' : item.name === 'edit_output_setting' ? 'editOutputSettingSelect(false)' : 'fConMasPdfSheetSelect()' %>"><%= r[text] || v[text] || text %></label> <% }); %>
            <% } else if (item.name === 'InitInputJudgeColor') { %><select id="rep_top_InitInputJudgeColor" name="rep_top.InitInputJudgeColor"><% for (const [value, text] of lineColors) { %><option value="<%= value %>" <%= item.value === value ? 'selected' : '' %>><%= r[text] || text %></option><% } %></select>
            <% } else if (item.options) { %><select id="rep_top_<%= item.name %>" name="rep_top.<%= item.name %>"><% item.options.forEach((text, index) => { %><option value="<%= index %>" <%= item.value === String(index) ? 'selected' : '' %>><%= r[text] || v[text] || text %></option><% }); %></select>
            <% } else if (item.name === 'InitInputJudgeThickness') { %><input type="range" id="rep_top_<%= item.name %>" name="rep_top.<%= item.name %>" min="1" max="5" step="1" value="<%= item.value %>">
            <% } else { %><input class="EditValue1" id="rep_top_<%= item.name %>" name="rep_top.<%= item.name %>" value="<%= item.value %>" <%= item.name === 'rep_top_name' ? 'required' : '' %>><% } %>
          <% } else { %><%= item.options ? r[item.options[Number(item.value)]] || v[item.options[Number(item.value)]] || item.value : item.value %><% } %>
          <% if (['output_setting','edit_output_setting'].includes(item.name)) { const output = outputs.find(output => output.name === (item.name === 'output_setting' ? 'output_files' : 'edit_output_files')); %>
            <div id="<%= item.name === 'output_setting' ? 'outputFilesSetting' : 'editOutputFilesSetting' %>" <%- !edit && item.value !== '2' ? 'style="display:none"' : '' %>>
              <%- include('output-options', {output}) %>
            </div>
          <% } %>
        </td></tr>
      <% } %>
      <% for (const name of ['rep_top_org','rev_no']) { %><tr><th scope="row"><%= r[name] %></th><td><%= report[name] %></td></tr><% } %>
      <tr><th scope="row"><%= r.PdfFontSizeDeductionAmount %></th><td><% if (edit) { %><input class="EditValue1" id="rep_top_option_PdfFontSizeDeductionAmount" name="rep_top_option.PdfFontSizeDeductionAmount" value="<%= fontDeduction %>" oninput="pdfFontSizeDeductionAmount(this)"><% } else { %><%= fontDeduction %><% } %></td></tr>
      <% for (const item of notifications.filter(item => item.options)) { const selected = item.multiple ? item.value.split(',').filter(Boolean) : [item.value]; const options = [...item.options, ...selected.filter(value => !item.options.some(option => option.value === value)).map(value => ({value, text: value}))]; %>
        <tr><th scope="row"><label for="rep_top_<%= item.name %>"><%= r[item.label] || item.label %></label></th><td>
          <% if (edit) { %><select id="rep_top_<%= item.name %>" name="rep_top.<%= item.name %>" <%= item.multiple ? 'multiple' : '' %>><% for (const option of options) { %><option value="<%= option.value %>" <%= selected.includes(option.value) ? 'selected' : '' %>><%= option.text %></option><% } %></select><% if (item.multiple) { %><input type="hidden" name="rep_top.<%= item.name %>" value=""><% } %>
          <% } else { %><%= selected.map(value => options.find(option => option.value === value)?.text || '').join(',') %><% } %>
        </td></tr>
      <% } %>
      <% for (const [label, available] of [['can_send_mail_as_attachment',attachment],['can_open_as_pdf',openPdf],['Biometrics',biometrics],['UseIdentification',identification]]) { %><tr><th scope="row"><%= r[label] %></th><td><%= available ? r.SELECTED_AVAILABLE_YES : r.SELECTED_AVAILABLE_NO %></td></tr><% } %>
      <tr><th scope="row"><%= r.AudioRecordingFileFormat %></th><td><%= audioFormat %></td></tr>
      <% if (edit) { %><tr><th scope="row"><label for="IsComplete"><%= v.isComplete %></label></th><td><input type="checkbox" id="IsComplete" name="IsComplete" value="true"><input type="hidden" name="IsComplete" value="false"></td></tr><% } %>
    </table></div>
    <div class="toggle" onclick="fConMasToggle('remarks')"><h2>▼<%= v.remark %></h2></div>
    <div id="remarks"><table cellpadding="0" cellspacing="0" class="table_information horizontal">
      <% for (const item of fields.filter(item => item.name.startsWith('top_remarks'))) { %><tr><th scope="row"><label for="rep_top_<%= item.name %>"><%= item.label %></label></th><td><% if (edit) { %><input class="EditValue1" id="rep_top_<%= item.name %>" name="rep_top.<%= item.name %>" value="<%= item.value %>"><% } else { %><%= item.value %><% } %></td></tr><% } %>
      <% for (const item of fields.filter(item => item.name.startsWith('system_key'))) { %><tr><th scope="row"><label for="rep_top_<%= item.name %>"><%= r.system_key %><%= item.name.slice(-1) %></label></th><td><% if (edit) { %><input class="EditValue1" id="rep_top_<%= item.name %>" name="rep_top.<%= item.name %>" value="<%= item.value %>"><% } else { %><%= item.value %><% } %></td></tr><% } %>
    </table></div>
    <% if (!edit) { %>
      <div class="toggle" onclick="fConMasToggle('approvalStatus')"><h2>▼<%= v.approveSheet %></h2></div>
      <div id="approvalStatus"><table cellpadding="0" cellspacing="0" class="table_information verticality">
        <tr><th scope="col"><%= r.rep_sheet_no %></th><th scope="col"><%= r.cluster_name %></th><th scope="col"><%= r.display_value %></th></tr>
        <% for (const row of approvals) { %><tr><td><%= row.rep_sheet_no %></td><td><%= row.cluster_name %></td><td><%- include('cluster-value', {row}) %></td></tr><% } %>
      </table></div>
      <% if (historyEnabled) { %><div class="toggle" onclick="fConMasToggle('historyList')"><h2>▼<%= r.History %></h2></div>
      <div id="historyList"><table class="GridCommon" border="0" cellspacing="1" id="histroryList">
        <tr><th scope="col"><%= r.rev_no %></th><th scope="col"><%= r.rep_top_name %></th><th scope="col"><%= r.sys_regist_time %></th><th scope="col"><%= r.sys_update_info %></th></tr>
        <% for (const row of history) { %><tr><td><%= row.rev_no %></td><td><a href="<%= base %>/InputReport/Details?repTopId=<%= row.rep_top_id %>"><%= row.rep_top_name %></a></td><td><%= row.registered %> <%= row.created_by %></td><td><%= row.updated %> <%= row.updated_by %></td></tr><% } %>
      </table></div><% } %>
    <% } %>
  </div></div>
</form>
<div id="contentTask" class="TaskDialog"></div><input type="hidden" id="detailsTopId" value="<%= report.rep_top_id %>">
