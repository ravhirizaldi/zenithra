<% const dateText = value => value ? new Date(value).toISOString().slice(0,16).replace('T',' ').replaceAll('-','/') : ''; %>
<% if(error) { %><p class="validation-summary-errors" role="alert"><%= error %></p><% } %>
<%- include('../shared/transfer-paging', { pageFunction: 'libraryPage' }) %>
<input type="hidden" id="PageIndex" name="PageIndex" value="<%= list.index %>"><input type="hidden" id="SortColumn" name="SortColumn" value="<%= list.order %>"><input type="hidden" id="SortDirection" name="SortDirection" value="<%= list.direction %>">
<div id="GridSection" class="manager-grid-scroll" tabindex="0" role="region" aria-label="Library documents"><table class="GridCommon manager-library-grid" cellspacing="1" id="DefReportList"><tr><th class="checkCol" style="width:30px;"><input type="checkbox" aria-label="Select all" onclick="$('.library-select').prop('checked',this.checked)"></th>
  <% for (const [column,title,width] of [['document_id','ID',45],['document_name','Name',0],...(mode === 'ImageLib' ? [] : [['document_save_kbn','Type of storage',60]]),['document_mobile_save','Availability to save on tablet',60],['sys_regist_time','Registration date and time',100],['sys_regist_user','Registrant',80],['sys_update_time','Last update date and time',100],['sys_update_user','Last updated by',80]]) { %><th scope="col" style="<%= width ? `width:${width}px;` : '' %>" class="<%= list.order === column ? 'sorting' : '' %>"><span><%= title %></span><a href="#" aria-label="Sort <%= title %>" class="sort <%= list.order === column ? list.direction === 'ASC' ? 'asc' : 'desc' : '' %>" onclick="librarySort('<%= column %>');return false;">sort</a></th><% } %>
</tr><% for (const [index,row] of list.rows.entries()) { %><tr class="<%= index%2 === 0 ? 'odd' : 'even' %>">
  <td class="checkCol"><% if(row.locked) { %><img src="<%= base %>/Content/ConMas/images/function/locked.png" width="15" height="15" alt="Locked"><% } else { %><input type="checkbox" class="library-select" value="<%= row.document_id %>" aria-label="Select <%= row.document_name %>"><% } %></td>
  <td class="CenterCol"><%= row.document_id %></td><td><span class="docTitle"><a href="<%= base %>/Library/Details?documentId=<%= row.document_id %>&mode=<%= mode %>&detailsMode=Search&isFirst=true"><%= row.document_name || '..' %></a></span><% const rowLabels = labels.filter(label => (row.label_ids || []).includes(label.mst_label_id)); if (rowLabels.length) { %><ul class="manager-document-labels"><% for (const label of rowLabels) { %><li><%= label.label_name %></li><% } %></ul><% } %>
  <% if(mode === 'ImageLib' && input.IstTumbnail === 'true') { %><br><img src="<%= base %>/Library/GetFreeDrawImageThumbnail?documentId=<%= row.document_id %>" alt="<%= row.document_name %>"><% } %></td>
  <% if(mode !== 'ImageLib') { %><td class="CenterCol"><%= ['File system','URL','FreeDraw'][Number(row.document_save_kbn)] %></td><% } %><td class="CenterCol"><%= Number(row.document_mobile_save) === 1 ? 'Available' : 'Not available' %></td>
  <td class="CenterCol"><%= dateText(row.sys_regist_time) %></td><td class="CenterCol"><%= row.created_by %></td><td class="CenterCol"><%= dateText(row.sys_update_time) %></td><td class="CenterCol"><%= row.updated_by %></td>
</tr><% } %></table></div>
