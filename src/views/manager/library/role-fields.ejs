<% const roleEditable = create || edit; const pageAction = view === 'role' ? "this.form.elements.ActionCommonType.value='PageType'" : "this.form.elements.act.value='PageType'"; %>
<div class="toggle"><h2><button type="button" class="manager-section-toggle" aria-expanded="true" aria-controls="GruopRoleSection">Another group permission settings</button></h2></div><div id="GruopRoleSection">
  <div class="manager-role-filters"><label>Group ID <input type="text" name="GroupSearchData.GroupId" value="<%= groupId %>"></label><label>Group Name <input type="text" name="GroupSearchData.GroupName" value="<%= groupSearch %>"></label>
  <button type="submit" class="image-search_user" onclick="<%= pageAction %>">Search</button></div>
  <div class="PageSection"><label>Displayed number <select name="PageData.PageSize" onchange="<%= pageAction %>;this.form.requestSubmit()"><% for(const count of [...new Set([10,20,50,100,size])].sort((a,b)=>a-b)) { %><option value="<%= count %>" <%= count===size ? 'selected' : '' %>><%= count %></option><% } %></select></label> <%= index+1 %> / <%= pages %>
  <% for(const [number,title,direction,disabled] of [[Math.max(0,index-1),'Previous','prev',index===0],[Math.min(pages-1,index+1),'Next','next',index>=pages-1]]) { %><button type="submit" class="img_page_<%= direction %>_<%= disabled ? 'd' : 'e' %>" aria-label="<%= title %> groups" title="<%= title %> groups" name="PageData.PageIndex" value="<%= number %>" <%= disabled ? 'disabled' : '' %> onclick="<%= pageAction %>"> </button><% } %></div>
  <% if(!fd) { %><p><% if(roleEditable) { %><label><input type="checkbox" name="IsRoleNone" value="true" <%= noRoles ? 'checked' : '' %> onchange="$('#GruopRoleTable input.manager-role-check').prop('disabled',this.checked)">No role settings</label><% } else { %><input type="hidden" name="IsRoleNone" value="<%= noRoles %>"><% if(noRoles) { %>No role settings<% } } %></p><% if(roleEditable) { %><p>Check "Yes" : Available to view. &nbsp; Check "No" : Not available to view.</p><% } } %>
  <div class="manager-grid-scroll"><table id="GruopRoleTable" class="table_information verticality"><tr><th style="width:60px;">Group ID</th><th>Group Name</th><th style="width:150px;">Refer</th><% if(fd) { %><th style="width:150px;">Edit</th><% } %></tr>
  <% for(const [i,group] of groups.entries()) { %><tr><td class="CenterCol"><%= group.group_id %><input type="hidden" name="GroupRolePage[<%= i %>].group_id" value="<%= group.group_id %>"></td><td><%= group.group_name_path %></td><td class="CenterCol"><input type="hidden" name="GroupRolePage[<%= i %>].IsReferRole" value="<%= Boolean(roles[group.group_id]?.read) %>"><% if(roleEditable) { %><input type="checkbox" class="manager-role-check" aria-label="Refer <%= group.group_name_path %>" <%= roles[group.group_id]?.read ? 'checked' : '' %> <%= !fd && noRoles ? 'disabled' : '' %> onchange="$(this).prev().val(String(this.checked));$(this).next().text(this.checked?'Available to refer':'No reference')"><% } %><span><%= roles[group.group_id]?.read ? 'Available to refer' : 'No reference' %></span></td><% if(fd) { %><td class="CenterCol"><input type="hidden" name="GroupRolePage[<%= i %>].IsEditRole" value="<%= Boolean(roles[group.group_id]?.edit) %>"><% if(roleEditable) { %><input type="checkbox" aria-label="Edit <%= group.group_name_path %>" <%= roles[group.group_id]?.edit ? 'checked' : '' %> onchange="$(this).prev().val(String(this.checked))"><% } else { %><%= roles[group.group_id]?.edit ? 'Yes' : 'No' %><% } %></td><% } %></tr><% } %></table>
</div></div>
