<% const ui = managerResources["shared"]; %><div class="PageSection">
  <%= ui["Displayed number"] %> <select name="PageSize" aria-label="<%= ui["Displayed number"] %>" onchange="<%= pageFunction %>(0)"><% for (const size of [...new Set([10,20,50,100,list.size])].sort((a,b)=>a-b)) { %><option value="<%= size %>" <%= list.size === size ? 'selected' : '' %>><%= size %></option><% } %></select>
  <% if (list.index > 0) { %><a href="#" onclick="<%= pageFunction %>(0);return false;"><%= ui["First"] %></a><% } %>
  <button type="button" class="img_page_prev_<%= list.index > 0 ? 'e' : 'd' %>" title="<%= ui["Previous page"] %>" aria-label="<%= ui["Previous page"] %>" onclick="<%= pageFunction %>(<%= Math.max(0,list.index-1) %>)" <%= list.index === 0 ? 'disabled' : '' %>> </button>
  <%= list.index+1 %> / <%= list.pages %> (<%= list.total %>)
  <button type="button" class="img_page_next_<%= list.index < list.pages-1 ? 'e' : 'd' %>" title="<%= ui["Next page"] %>" aria-label="<%= ui["Next page"] %>" onclick="<%= pageFunction %>(<%= Math.min(list.pages-1,list.index+1) %>)" <%= list.index >= list.pages-1 ? 'disabled' : '' %>> </button>
  <% if (list.index < list.pages-1) { %><a href="#" onclick="<%= pageFunction %>(<%= list.pages-1 %>);return false;"><%= ui["Last"] %></a><% } %>
</div>
