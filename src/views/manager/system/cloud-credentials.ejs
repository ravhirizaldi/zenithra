<% const ui = managerResources["system"]; %><% const page = cloudCredentialsPage; const model = page.model || {}; const route = page.route; %>
<% if (page.mode === 'unavailable') { %>
  <div class="PartialViewMessage" role="alert"><%= page.error || ui["Role authority is insufficient."] %></div>
<% } else if (page.provider === 'google') { %>
  <div class="PartialViewMessage" role="alert"><% if (page.error) { %><ul><li><%= page.error %></li></ul><% } %></div>
  <div id="DetailTop"><span id="infoTitle"><%= ui["Google authentication registration"] %></span></div>
  <div id="DetailSection">
    <div class="info">
      <div class="toggle" role="button" tabindex="0" aria-expanded="true" aria-controls="credentialsSetting" onclick="fConMasToggle('credentialsSetting');this.setAttribute('aria-expanded',this.getAttribute('aria-expanded')==='true'?'false':'true');" onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();this.click();}">
        <h2 style="margin-top:5px; margin-bottom:10px"><%= ui["▼Registration of certification information"] %></h2>
      </div>
      <div id="credentialsSetting">
        <div style="margin-left:30px; margin-top:30px; margin-bottom:40px">
          <% const credentialType = Number(model.CredentialType) === 1 ? 1 : 0; %>
          <% for (const [type, label] of [[0, 'Service account authentication'], [1, 'OAuth2.0 authentication']]) { %>
            <% if (credentialType === type) { %>
              <div class="tabButtonSelect" style="width:200px; pointer-events:none"><%= label %></div>
            <% } else if (page.canEdit) { %>
              <a href="<%= route %>?credentialType=<%= type %>&amp;__RequestVerificationToken=<%= encodeURIComponent(csrfToken) %>" class="tabButtonNormal" style="width:200px"><%= label %></a>
            <% } else { %>
              <div class="tabButtonNormal" style="width:200px"><%= label %></div>
            <% } %>
          <% } %>
          <% if (page.canEdit) { %>
            <form method="post" enctype="multipart/form-data" action="<%= route %>">
              <input type="hidden" name="__RequestVerificationToken" value="<%= csrfToken %>">
              <input type="hidden" name="CredentialType" value="<%= credentialType %>">
              <div style="margin-top:30px; margin-left:30px">
                <label for="file"><%= ui["File"] %></label>
                <input type="file" name="file" id="file" accept="application/json,.json" required>
                <button type="submit"><%= ui["Upload"] %></button>
              </div>
            </form>
          <% } %>
        </div>
      </div>
      <div class="toggle" role="button" tabindex="0" aria-expanded="true" aria-controls="registrationInfo" onclick="fConMasToggle('registrationInfo');this.setAttribute('aria-expanded',this.getAttribute('aria-expanded')==='true'?'false':'true');" onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();this.click();}">
        <h2 style="margin-top:5px; margin-bottom:10px"><%= ui["▼Registration information"] %></h2>
      </div>
      <div id="registrationInfo">
        <% if (!model.HasCredential) { %>
          <div style="margin:20px 30px"><%= ui["Authorization information is missing"] %></div>
        <% } else { %>
          <table class="table_information horizontal" style="padding:0; border-spacing:0; border-collapse:collapse">
            <% if (model.ServiceAccountKey) { %><tr><th scope="row"><%= ui["Key"] %></th><td><%= model.ServiceAccountKey %></td></tr><% } %>
            <% if (model.OAuthClientId) { %><tr><th scope="row"><%= ui["Client ID"] %></th><td><%= model.OAuthClientId %></td></tr><% } %>
            <% if (model.EmailAddress) { %><tr><th scope="row"><%= ui["E-mail address"] %></th><td><%= model.EmailAddress %></td></tr><% } %>
          </table>
        <% } %>
      </div>
    </div>
  </div>
<% } else if (page.provider === 'box') { %>
  <div class="PartialViewMessage" role="alert"><% if (page.error) { %><ul><li><%= page.error %></li></ul><% } %></div>
  <div id="DetailTop">
    <span id="infoTitle"><%= ui["Box linkage setting"] %></span>
    <span id="functionBar">
      <% if (page.mode !== 'edit' && page.canEdit) { %><a href="<%= route %>?act=edit" id="boxFunction" class="img_edit" title="<%= ui["Edit"] %>" aria-label="<%= ui["Edit"] %>"> </a><% } %>
      <% if (page.mode !== 'edit' && page.canDelete) { %>
        <form method="post" action="<%= route %>" style="display:inline" onsubmit="return confirm(<%= managerScriptText(ui["Release the linkage. Continue?"], "'") %>)">
          <input type="hidden" name="__RequestVerificationToken" value="<%= csrfToken %>">
          <input type="hidden" name="act" value="delete">
          <button type="submit" class="img_delete" title="<%= ui["Delete"] %>" aria-label="<%= ui["Delete"] %>"></button>
        </form>
      <% } %>
    </span>
  </div>
  <form method="post" action="<%= route %>">
    <input type="hidden" name="__RequestVerificationToken" value="<%= csrfToken %>">
    <input type="hidden" name="act" value="<%= page.mode === 'edit' ? 'edit' : '' %>">
    <div id="DetailSection">
      <div class="info">
        <div class="toggle" role="button" tabindex="0" aria-expanded="true" aria-controls="boxSetting" onclick="fConMasToggle('boxSetting');this.setAttribute('aria-expanded',this.getAttribute('aria-expanded')==='true'?'false':'true');" onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();this.click();}">
          <h2 style="margin-top:5px; margin-bottom:10px"><%= ui["▼Box authentication setting"] %></h2>
        </div>
        <div id="boxSetting">
          <table class="table_information horizontal" style="padding:0; border-spacing:0; border-collapse:collapse">
            <tr><th scope="row"><label for="box-client-id"><%= ui["Client ID"] %></label></th><td>
              <% if (page.mode === 'edit') { %><input id="box-client-id" class="EditValue1" name="ClientId" value="<%= model.ClientId || '' %>" required>
              <% } else { %><%= model.ClientId || '' %><% } %>
            </td></tr>
            <tr><th scope="row"><label for="box-client-secret"><%= ui["Client Secret"] %></label></th><td>
              <% if (page.mode === 'edit') { %><input id="box-client-secret" class="EditValue1" name="ClientSecret" value="<%= model.ClientSecret || '' %>" required>
              <% } else { %><%= model.ClientSecretConfigured ? ui["Configured"] : '' %><% } %>
            </td></tr>
            <tr><th scope="row"><label for="box-enterprise-id"><%= ui["Enterprise ID"] %></label></th><td>
              <% if (page.mode === 'edit') { %><input id="box-enterprise-id" class="EditValue1" name="EnterpriseId" value="<%= model.EnterpriseId || '' %>" required>
              <% } else { %><%= model.EnterpriseId || '' %><% } %>
            </td></tr>
          </table>
        </div>
        <% if (page.mode !== 'edit') { %>
          <div class="toggle" role="button" tabindex="0" aria-expanded="true" aria-controls="boxLinkageInfo" onclick="fConMasToggle('boxLinkageInfo');this.setAttribute('aria-expanded',this.getAttribute('aria-expanded')==='true'?'false':'true');" onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();this.click();}">
            <h2 style="margin-top:5px; margin-bottom:10px"><%= ui["▼Box linkage information"] %></h2>
          </div>
          <div id="boxLinkageInfo"><table class="table_information horizontal" style="padding:0; border-spacing:0; border-collapse:collapse">
            <tr><th scope="row"><%= ui["Application name"] %></th><td><%= model.ApplicationName || '' %></td></tr>
            <tr><th scope="row"><%= ui["Service account"] %></th><td><%= model.AccountId || '' %></td></tr>
          </table></div>
        <% } %>
        <% if (page.mode === 'edit' && page.canEdit) { %>
          <p><button type="submit" class="image-ok_btn"><%= ui["Confirm"] %></button> <a href="<%= base %>/System?mode=box&amp;act=back" id="image-cancel_btn" class="image-cancel_label"><%= ui["Cancel"] %></a></p>
        <% } %>
      </div>
    </div>
  </form>
<% } else { %>
  <div class="PartialViewMessage" role="alert"><% if (page.error) { %><ul><li><%= page.error %></li></ul><% } %></div>
  <div id="DetailTop">
    <span id="infoTitle"><%= ui["Autodesk Docs linkage setting"] %></span>
    <span id="functionBar">
      <% if (!['edit', 'certify'].includes(page.mode) && page.canEdit) { %><a href="<%= route %>?act=edit" id="Bim360Function" class="img_edit" title="<%= ui["Edit"] %>" aria-label="<%= ui["Edit"] %>"> </a><% } %>
      <% if (!['edit', 'certify'].includes(page.mode) && page.canDelete) { %>
        <form method="post" action="<%= route %>" style="display:inline" onsubmit="return confirm(<%= managerScriptText(ui["Release the linkage. Continue?"], "'") %>)">
          <input type="hidden" name="__RequestVerificationToken" value="<%= csrfToken %>">
          <input type="hidden" name="act" value="delete">
          <button type="submit" class="img_delete" title="<%= ui["Delete"] %>" aria-label="<%= ui["Delete"] %>"></button>
        </form>
      <% } %>
    </span>
  </div>
  <form method="post" action="<%= route %>">
    <input type="hidden" name="__RequestVerificationToken" value="<%= csrfToken %>">
    <% if (page.mode === 'details') { %>
      <div id="DetailSection"><div class="info">
        <div class="toggle" role="button" tabindex="0" aria-expanded="true" aria-controls="bim360Setting" onclick="fConMasToggle('bim360Setting');this.setAttribute('aria-expanded',this.getAttribute('aria-expanded')==='true'?'false':'true');" onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();this.click();}">
          <h2 style="margin-top:5px; margin-bottom:10px"><%= ui["▼Autodesk Docs authentication setting"] %></h2>
        </div>
        <div id="bim360Setting"><table class="table_information horizontal" style="padding:0; border-spacing:0; border-collapse:collapse">
          <tr><th scope="row"><%= ui["Client ID"] %></th><td><%= model.ClientId || '' %></td></tr>
          <tr><th scope="row"><%= ui["Client Secret"] %></th><td><%= model.ClientSecretConfigured ? ui["Configured"] : '' %></td></tr>
        </table></div>
        <% const target = model.TargetHubAndProject || {}; %>
        <div class="toggle" role="button" tabindex="0" aria-expanded="true" aria-controls="bim360LinkageInfo" onclick="fConMasToggle('bim360LinkageInfo');this.setAttribute('aria-expanded',this.getAttribute('aria-expanded')==='true'?'false':'true');" onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();this.click();}">
          <h2 style="margin-top:5px; margin-bottom:10px"><%= ui["▼Autodesk Docs linkage information"] %></h2>
        </div>
        <div id="bim360LinkageInfo">
          <table class="table_information horizontal" style="padding:0; border-spacing:0; border-collapse:collapse">
            <tr><th scope="row"><%= ui["Hub ID"] %></th><td><%= target.HubId || '' %></td></tr>
            <tr><th scope="row"><%= ui["Hub name"] %></th><td><%= target.HubName || '' %></td></tr>
          </table>
          <table class="table_information verticality" style="padding:0; border-spacing:0; border-collapse:collapse">
            <thead><tr><th scope="col" width="50%"><%= ui["Project ID"] %></th><th scope="col" width="50%"><%= ui["Project Name"] %></th></tr></thead>
            <tbody><% for (const project of target.Projects || []) { %><tr><td><%= project.ProjectId %></td><td><%= project.ProjectName %></td></tr><% } %></tbody>
          </table>
        </div>
      </div></div>
    <% } else if (page.mode === 'edit') { %>
      <input type="hidden" name="act" value="edit">
      <div id="DetailSection"><div class="info">
        <div class="toggle" role="button" tabindex="0" aria-expanded="true" aria-controls="bim360Setting" onclick="fConMasToggle('bim360Setting');this.setAttribute('aria-expanded',this.getAttribute('aria-expanded')==='true'?'false':'true');" onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();this.click();}">
          <h2 style="margin-top:5px; margin-bottom:10px"><%= ui["▼Autodesk Docs authentication setting"] %></h2>
        </div>
        <div id="bim360Setting"><table class="table_information horizontal" style="padding:0; border-spacing:0; border-collapse:collapse">
          <tr><th scope="row"><label for="bim360-client-id"><%= ui["Client ID"] %></label></th><td><input id="bim360-client-id" class="EditValue1" name="ClientId" value="<%= model.ClientId || '' %>" required></td></tr>
          <tr><th scope="row"><label for="bim360-client-secret"><%= ui["Client Secret"] %></label></th><td><input id="bim360-client-secret" class="EditValue1" name="ClientSecret" value="<%= model.ClientSecret || '' %>" required></td></tr>
        </table></div>
        <% if (page.canEdit) { %><p><button type="submit" name="act" value="certify" class="button_custom" style="margin-left:14px"><%= ui["certification"] %></button> <a href="<%= base %>/System?mode=bim360&amp;act=back" id="image-cancel_btn" class="image-cancel_label"><%= ui["Cancel"] %></a></p><% } %>
      </div></div>
    <% } else if (page.mode === 'certify') { %>
      <input type="hidden" name="ClientId" value="<%= model.ClientId || '' %>">
      <div id="DetailSection"><div class="info">
        <div class="toggle" role="button" tabindex="0" aria-expanded="true" aria-controls="bim360Setting" onclick="fConMasToggle('bim360Setting');this.setAttribute('aria-expanded',this.getAttribute('aria-expanded')==='true'?'false':'true');" onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();this.click();}">
          <h2 style="margin-top:5px; margin-bottom:10px"><%= ui["▼Autodesk Docs authentication setting"] %></h2>
        </div>
        <div id="bim360Setting"><table class="table_information horizontal" style="padding:0; border-spacing:0; border-collapse:collapse">
          <tr><th scope="row"><%= ui["Client ID"] %></th><td><%= model.ClientId || '' %></td></tr>
          <tr><th scope="row"><%= ui["Client Secret"] %></th><td><%= model.ClientSecretConfigured ? ui["Configured"] : '' %></td></tr>
        </table></div>
        <% if (page.canEdit) { %>
          <p><button type="submit" name="act" value="cancel" class="button_custom" style="margin-left:14px"><%= ui["Cancel"] %></button></p>
          <div class="toggle" role="button" tabindex="0" aria-expanded="true" aria-controls="bim360TargetSetting" onclick="fConMasToggle('bim360TargetSetting');this.setAttribute('aria-expanded',this.getAttribute('aria-expanded')==='true'?'false':'true');" onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();this.click();}">
            <h2 style="margin-top:5px; margin-bottom:10px"><%= ui["▼Select projects to be linked"] %></h2>
          </div>
          <div id="bim360TargetSetting">
            <% for (const hub of model.HubSelections || []) { %>
              <div style="margin-left:20px; margin-bottom:10px">
                <label><input type="radio" name="SelectedHubId" id="hub_<%= hub.HubId %>" value="<%= hub.HubId %>" <%= model.SelectedHubId === hub.HubId ? 'checked' : '' %> onchange="setBim360ProjectState(this.value)" required> <%= hub.HubName %> <%= ui["(ID:"] %><%= hub.HubId %>)</label>
                <div data-bim360-hub="<%= hub.HubId %>" style="margin-left:30px">
                  <% for (const project of hub.Projects || []) { %>
                    <label><input type="checkbox" name="SelectedProject[<%= project.ProjectId %>]" id="project_<%= hub.HubId %>_<%= project.ProjectId %>" value="true" <%= project.Selected ? 'checked' : '' %> <%= model.SelectedHubId === hub.HubId ? '' : 'disabled' %>> <%= project.ProjectName %> <%= ui["(ID:"] %><%= project.ProjectId %>)</label><br>
                  <% } %>
                </div>
              </div>
            <% } %>
            <p><button type="submit" name="act" value="regist" class="image-ok_btn"><%= ui["Confirm"] %></button> <a href="<%= base %>/System?mode=bim360&amp;act=back" id="image-cancel_btn" class="image-cancel_label"><%= ui["Cancel"] %></a></p>
          </div>
          <script>
            function setBim360ProjectState(hubId) {
              document.querySelectorAll('[data-bim360-hub]').forEach(function (container) {
                var active = container.getAttribute('data-bim360-hub') === hubId;
                container.querySelectorAll('input[type="checkbox"]').forEach(function (checkbox) {
                  if (!active) checkbox.checked = false;
                  checkbox.disabled = !active;
                });
              });
            }
            (function () {
              var selected = document.querySelector('input[name="SelectedHubId"]:checked');
              if (selected) setBim360ProjectState(selected.value);
            }());
          </script>
        <% } %>
      </div></div>
    <% } %>
  </form>
<% } %>
