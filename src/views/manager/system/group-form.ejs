<% const p = systemGroupPage; const group = p.group; const layout = p.layout; const has = (row, field) => row[field] === true || row[field] === 1 || row[field] === '1' || row[field] === 't'; const systemColumns = layout.system.flatMap(section => section.columns); const managerColumns = layout.manager.flatMap(section => section.columns); const selected = new Set(p.selectedIds || []); const action = base + '/System/' + (p.mode === 'create' ? 'CreateGroup' : 'EditGroup'); %>
<div class="PartialViewMessage"><% if (p.error) { %><ul><li><%= p.error %></li></ul><% } %></div>
<div id="DetailTop"><span id="infoTitle"><%= p.mode === 'create' ? 'Register new group' : 'Edit group' %></span></div>
<form id="group-edit-form" method="post" action="<%= action %>">
  <input type="hidden" name="__RequestVerificationToken" value="<%= csrfToken %>" />
  <% if (p.mode === 'edit') { %><input type="hidden" name="mst_group.group_id" value="<%= group.group_id %>" /><% } %>
  <div id="DetailSection"><div class="info">
    <table cellpadding="0" cellspacing="0" class="table_information horizontal">
      <tr><th scope="row">Group Name</th><td><input type="text" name="mst_group.group_name" class="EditValue1" value="<%= group.group_name || '' %>" required /></td></tr>
      <tr><th scope="row"><%= p.mode === 'create' ? 'Parent group name' : 'Parent group name path' %></th><td><select name="mst_group.upper_group_id">
        <option value="-1" <%= Number(group.upper_group_id) === -1 || group.upper_group_id == null ? 'selected' : '' %>></option>
        <% p.parents.forEach(parent => { %><option value="<%= parent.group_id %>" <%= Number(group.upper_group_id) === Number(parent.group_id) ? 'selected' : '' %>><%= parent.group_name_path %></option><% }) %>
      </select></td></tr>
      <% if (p.features.groupKeyMode) { %><tr><th scope="row">System key </th><td><input type="text" name="mst_group.systemKey" class="EditValue1" value="<%= group.system_key || group.systemKey || '' %>" /></td></tr><% } %>
    </table>

    <div style="overflow:auto; width:100%;">
      <table cellpadding="0" cellspacing="0" id="conmasGroupSettingBox" class="table_information verticality" style="width:<%= p.features.freeDrawOnly ? '2200px' : '3500px' %>; min-width:<%= p.features.freeDrawOnly ? '2200px' : '3500px' %>;">
        <thead>
          <tr>
            <th scope="col" rowspan="2" style="width:30px;"></th>
            <th scope="col" colspan="4" rowspan="2" class="system_role">System</th>
            <th scope="col" colspan="<%= systemColumns.length - 4 %>" class="system_role"></th>
            <th scope="col" colspan="<%= managerColumns.length %>" class="manager_role">Manager permission</th>
            <th scope="col" rowspan="3">API</th>
            <% if (layout.designer.length) { %><th scope="col" colspan="<%= layout.designer.length %>" class="designer_role">Designer permission</th><% } %>
            <% if (layout.defaultDefinition.length) { %><th scope="col" colspan="7">Default authority of form</th><% } %>
            <% if (layout.freeDraw.length) { %><th scope="col" colspan="2">Default i-Repo FreeDraw authority</th><% } %>
          </tr>
          <tr>
            <% layout.system.slice(1).forEach(section => { %><th scope="col" colspan="<%= section.columns.length %>" class="system_role"><%= section.title %></th><% }) %>
            <% layout.manager.forEach(section => { %><th scope="col" colspan="<%= section.columns.length %>" rowspan="<%= section.rowspan || 1 %>" class="manager_role"><%= section.title %></th><% }) %>
            <% layout.designer.forEach(column => { %><th scope="col" rowspan="2" class="designer_role"><%= column.label %></th><% }) %>
            <% if (layout.defaultDefinition.length) { %><th scope="col" colspan="3">Form</th><th scope="col" colspan="4">Document</th><% } %>
            <% layout.freeDraw.forEach(column => { %><th scope="col" rowspan="2"><%= column.label %></th><% }) %>
          </tr>
          <tr>
            <th scope="row"></th>
            <% layout.system.forEach(section => section.columns.forEach(column => { %><th scope="row" class="system_role"><%= column.label %></th><% })) %>
            <% layout.manager.filter(section => !section.rowspan).forEach(section => section.columns.forEach(column => { %><th scope="row" class="manager_role"><%= column.label %></th><% })) %>
            <% layout.defaultDefinition.forEach(column => { %><th scope="row"><%= column.label %></th><% }) %>
          </tr>
        </thead>
        <tbody><tr>
          <td></td>
          <% layout.system.forEach(section => section.columns.forEach(column => { %><td class="center"><input type="checkbox" name="mst_group.<%= column.field %>" value="1" <%= has(group,column.field) ? 'checked' : '' %> /></td><% })) %>
          <% layout.manager.forEach(section => section.columns.forEach(column => { %><td class="center"><input type="checkbox" name="mst_group.<%= column.field %>" value="1" <%= has(group,column.field) ? 'checked' : '' %> /></td><% })) %>
          <td class="center"><input type="checkbox" name="mst_group.role_api_execute" value="1" <%= has(group,'role_api_execute') ? 'checked' : '' %> /></td>
          <% layout.designer.forEach(column => { %><td class="center"><input type="checkbox" name="mst_group.<%= column.field %>" value="1" <%= has(group,column.field) ? 'checked' : '' %> /></td><% }) %>
          <% layout.defaultDefinition.forEach(column => { %><td class="center"><input type="checkbox" name="mst_group.<%= column.field %>" value="1" <%= has(group,column.field) ? 'checked' : '' %> /></td><% }) %>
          <% layout.freeDraw.forEach(column => { %><td class="center"><input type="checkbox" name="mst_group.<%= column.field %>" value="1" <%= has(group,column.field) ? 'checked' : '' %> /></td><% }) %>
        </tr></tbody>
      </table>
    </div>

    <table cellpadding="0" cellspacing="0" class="table_information horizontal">
      <tr><th scope="row">Group Remarks</th><td><input type="text" name="mst_group.group_remarks" class="EditValue1" value="<%= group.group_remarks || '' %>" /></td></tr>
      <% if (p.features.freeDraw) { %><tr><th scope="row" style="width:250px;">i-Repo FreeDraw setting template</th><td><select name="mst_group.IrfdTemplateId"><% p.templates.forEach(template => { %><option value="<%= template.template_id %>" <%= Number(group.IrfdTemplateId || group.irfd_template_id || 1) === Number(template.template_id) ? 'selected' : '' %>><%= template.template_name %></option><% }) %></select></td></tr><% } %>
    </table>

    <div class="toggle" onclick="var box=document.getElementById('groupUser');box.hidden=!box.hidden"><h2>▼Affiliation of user</h2></div>
    <div id="groupUser">
      <div>
        User ID&nbsp;<input type="text" id="group-user-id-filter" />
        &nbsp;&nbsp;User name&nbsp;<input type="text" id="group-user-name-filter" />
        &nbsp;&nbsp;<input type="button" id="group-user-search" value="Search" class="image-search_user" />
      </div>
      <div class="PageSection">
        Displayed number&nbsp;<select id="group-user-page-size"><% p.userPageSizes.forEach(size => { %><option value="<%= size %>" <%= Number(p.userPageSize) === Number(size) ? 'selected' : '' %>><%= size %></option><% }) %></select>
        &nbsp;<a href="#" id="group-user-first" hidden>First</a>
        <a href="#" id="group-user-prev" class="img_page_prev_e" aria-label="Previous page" hidden> </a><img src="<%= base %>/Content/ConMas/images/grid/page_prev_d.png" alt="prev_d" id="group-user-prev-disabled" />
        &nbsp;<span id="group-user-page-label">1 / 1</span>&nbsp;
        <a href="#" id="group-user-next" class="img_page_next_e" aria-label="Next page" hidden> </a><img src="<%= base %>/Content/ConMas/images/grid/page_next_d.png" alt="next_d" id="group-user-next-disabled" />
        <a href="#" id="group-user-last" hidden>Last</a>
      </div>
      <div style="overflow:auto; width:100%;">
        <table cellpadding="0" cellspacing="0" class="table_information verticality" id="group-user-table">
          <thead><tr><th scope="col"><input type="checkbox" id="group-user-check-all" aria-label="Select all users on page" /></th><th scope="col">User ID</th><th scope="col">User name</th></tr></thead>
          <tbody>
            <% p.users.forEach(user => { const userId = String(user.user_id); %>
              <tr data-user-id="<%= userId.toLowerCase() %>" data-user-name="<%= String(user.user_name).toLowerCase() %>">
                <td class="center"><input type="checkbox" name="members" value="<%= userId %>" <%= selected.has(userId) ? 'checked' : '' %> /></td>
                <td><%= user.user_id %></td><td><%= user.user_name %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <div class="PageSection">
        Displayed number&nbsp;<select id="group-user-page-size-bottom"><% p.userPageSizes.forEach(size => { %><option value="<%= size %>" <%= Number(p.userPageSize) === Number(size) ? 'selected' : '' %>><%= size %></option><% }) %></select>
        &nbsp;<a href="#" id="group-user-first-bottom" hidden>First</a>
        <a href="#" id="group-user-prev-bottom" class="img_page_prev_e" aria-label="Previous page" hidden> </a><img src="<%= base %>/Content/ConMas/images/grid/page_prev_d.png" alt="prev_d" id="group-user-prev-bottom-disabled" />
        &nbsp;<span id="group-user-page-label-bottom">1 / 1</span>&nbsp;
        <a href="#" id="group-user-next-bottom" class="img_page_next_e" aria-label="Next page" hidden> </a><img src="<%= base %>/Content/ConMas/images/grid/page_next_d.png" alt="next_d" id="group-user-next-bottom-disabled" />
        <a href="#" id="group-user-last-bottom" hidden>Last</a>
      </div>
    </div>
    <div class="PageSection">
      <input type="submit" value="Confirm" class="image-ok_btn" />&nbsp;
      <a href="<%= base %>/System/GroupList" class="image-cancel_label" id="image-cancel_btn">Cancel</a>
    </div>
  </div></div>
</form>
<script>
  (function () {
    var table = document.getElementById('group-user-table');
    if (!table) return;
    var rows = Array.prototype.slice.call(table.querySelectorAll('tbody tr'));
    var idFilter = document.getElementById('group-user-id-filter');
    var nameFilter = document.getElementById('group-user-name-filter');
    var pageSize = document.getElementById('group-user-page-size');
    var pageSizeBottom = document.getElementById('group-user-page-size-bottom');
    var current = 0;
    var filtered = rows;
    function refresh() {
      filtered = rows.filter(function (row) {
        return row.dataset.userId.indexOf(idFilter.value.toLowerCase()) >= 0 && row.dataset.userName.indexOf(nameFilter.value.toLowerCase()) >= 0;
      });
      var size = Number(pageSize.value) || 20;
      var pages = Math.max(1, Math.ceil(filtered.length / size));
      current = Math.min(current, pages - 1);
      rows.forEach(function (row) { row.hidden = true; });
      filtered.slice(current * size, (current + 1) * size).forEach(function (row) { row.hidden = false; });
      var label = (filtered.length ? current + 1 : 0) + ' / ' + pages;
      document.getElementById('group-user-page-label').textContent = label;
      document.getElementById('group-user-page-label-bottom').textContent = label;
      pageSize.value = String(size);
      pageSizeBottom.value = String(size);
      var previous = current > 0;
      var next = current < pages - 1;
      ['group-user-first','group-user-prev'].forEach(function (id) { document.getElementById(id).hidden = !previous; });
      document.getElementById('group-user-prev-disabled').hidden = previous;
      ['group-user-first-bottom','group-user-prev-bottom'].forEach(function (id) { document.getElementById(id).hidden = !previous; });
      document.getElementById('group-user-prev-bottom-disabled').hidden = previous;
      ['group-user-next','group-user-last'].forEach(function (id) { document.getElementById(id).hidden = !next; });
      document.getElementById('group-user-next-disabled').hidden = next;
      ['group-user-next-bottom','group-user-last-bottom'].forEach(function (id) { document.getElementById(id).hidden = !next; });
      document.getElementById('group-user-next-bottom-disabled').hidden = next;
    }
    function move(value) {
      var size = Number(pageSize.value) || 20;
      var pages = Math.max(1, Math.ceil(filtered.length / size));
      current = Math.max(0, Math.min(pages - 1, value));
      refresh();
    }
    document.getElementById('group-user-search').addEventListener('click', function () { current = 0; refresh(); });
    idFilter.addEventListener('keydown', function (event) { if (event.key === 'Enter') { event.preventDefault(); current = 0; refresh(); } });
    nameFilter.addEventListener('keydown', function (event) { if (event.key === 'Enter') { event.preventDefault(); current = 0; refresh(); } });
    [pageSize,pageSizeBottom].forEach(function (select) { select.addEventListener('change', function () { pageSize.value = select.value; pageSizeBottom.value = select.value; current = 0; refresh(); }); });
    ['group-user-first','group-user-first-bottom'].forEach(function (id) { document.getElementById(id).addEventListener('click', function (event) { event.preventDefault(); move(0); }); });
    ['group-user-prev','group-user-prev-bottom'].forEach(function (id) { document.getElementById(id).addEventListener('click', function (event) { event.preventDefault(); move(current - 1); }); });
    ['group-user-next','group-user-next-bottom'].forEach(function (id) { document.getElementById(id).addEventListener('click', function (event) { event.preventDefault(); move(current + 1); }); });
    ['group-user-last','group-user-last-bottom'].forEach(function (id) { document.getElementById(id).addEventListener('click', function (event) { event.preventDefault(); move(Math.ceil(filtered.length / (Number(pageSize.value) || 20)) - 1); }); });
    document.getElementById('group-user-check-all').addEventListener('change', function (event) {
      var checked = event.target.checked;
      filtered.slice(current * (Number(pageSize.value) || 20), (current + 1) * (Number(pageSize.value) || 20)).forEach(function (row) {
        var checkbox = row.querySelector('input[type="checkbox"]');
        checkbox.checked = checked;
      });
    });
    refresh();
  })();
</script>
