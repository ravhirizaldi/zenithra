<% const ui = managerResources["system"]; %><% const g=general.GeneralRequestItem; const readonlyStyle='width:280px;background-color:#f0f0f0;border:1px solid #999;margin:auto 1px;'; %>
<div class="PartialViewMessage"><% if(wp.error){ %><ul><li><%= wp.error %></li></ul><% } %><% if(wp.errors?.length){ %><ul><% for(const error of wp.errors){ %><li><%= error %></li><% } %></ul><% } %></div>
<div id="DetailTop"><span id="infoTitle"><%= ui["Application linkage settingEdit"] %></span><span id="functionBar"><input type="submit" form="generalWebhookForm" class="image-ok_btn" value="Test  Notify" onclick="document.getElementById('generalWebhookAct').value='testSend'"></span></div>
<form method="post" action="<%= root %>/EditWebhookSettingGeneral" id="generalWebhookForm">
  <input type="hidden" name="__RequestVerificationToken" value="<%= csrfToken %>"><input type="hidden" name="WebhookId" value="<%= general.WebhookId %>"><input type="hidden" name="act" id="generalWebhookAct" value="">
  <div id="DetailSection"><div class="info">
    <table style="padding:0;border-spacing:0;border-collapse:collapse;" class="table_information horizontal">
      <tr><th scope="row"><label for="generalWebhookType"><%= ui["Webhook notification address"] %></label></th><td><select id="generalWebhookType" name="WebhookTo" onchange="generalWebhookTypeChanged(this.value)"><% for(const kind of wp.webhookTargets){ %><option value="<%= kind %>"<%- selected(kind,general.WebhookTo) %>><%= wp.targetName(kind) %></option><% } %></select></td></tr>
      <tr><th scope="row"><label for="WebhookName"><%= ui["Name of webhook"] %></label></th><td><input class="EditValue1" id="WebhookName" name="WebhookName" value="<%= general.WebhookName %>"></td></tr>
      <tr><th scope="row"><label for="Endpoint"><%= ui["Endpoint (URL)"] %></label></th><td><input class="EditValue1" id="Endpoint" name="Endpoint" value="<%= general.Endpoint %>"></td></tr>
      <tr><th scope="row"><label for="HttpMethod"><%= ui["HTTP Method"] %></label></th><td><select id="HttpMethod" name="HttpMethod"><% for(const method of wp.generalMethods){ %><option value="<%= method %>"<%- selected(method,general.HttpMethod) %>><%= method %></option><% } %></select></td></tr>
      <tr><th scope="row"><%= ui["Params"] %></th><td><%- include('webhook-pairs',{wp,container:'generalParams',prefix:'GeneralRequestItem.Params',pairs:g.Params,hideHead:false}) %></td></tr>
      <tr><th scope="row"><label for="GeneralRequestItem.Authentication.Type"><%= ui["Authentication"] %></label></th><td>
        <div style="float:left;margin-right:20px;"><select id="GeneralRequestItem.Authentication.Type" name="GeneralRequestItem.Authentication.Type" onchange="generalAuthChanged(this.value)"><option value="None"<%- selected(g.Authentication.Type,'None') %>><%= ui["Non"] %></option><option value="BasicAuth"<%- selected(g.Authentication.Type,'BasicAuth') %>><%= ui["Basic authentication"] %></option><option value="BearerToken"<%- selected(g.Authentication.Type,'BearerToken') %>><%= ui["Bearer authentication"] %></option></select></div>
        <div style="float:left;"><div id="generalBasicAuth">
          <div><label><%= ui["User name"] %> <input name="GeneralRequestItem.Authentication.Username" value="<%= g.Authentication.Username %>" style="margin-left:4px;margin-bottom:4px;width:250px;"></label></div>
          <div><label><%= ui["Password"] %> <input id="generalPassword" type="text" name="GeneralRequestItem.Authentication.Password" value="<%= g.Authentication.Password %>" style="margin-left:4px;margin-bottom:4px;width:250px;" autocomplete="off"></label></div>
          <div><label><input id="generalShowPassword" type="checkbox" onchange="generalShowPasswordChanged(this.checked)"><%= ui["Show password"] %></label></div>
        </div><div id="generalBearerAuth"><label><%= ui["Token"] %> <input name="GeneralRequestItem.Authentication.Token" value="<%= g.Authentication.Token %>" style="margin-left:4px;width:430px;"></label></div></div>
      </td></tr>
      <tr><th scope="row"><%= ui["Headers"] %></th><td>
        <div class="generalPairHead"><span style="display:inline-block;width:280px;text-align:center;"><%= ui["Key"] %></span><span style="display:inline-block;width:280px;text-align:center;"><%= ui["Value"] %></span></div>
        <div class="generalPairRow" id="generalAuthorizationHeader" style="width:610px;padding:4px 0;border-top:solid 1px #999;"><input readonly aria-label="<%= ui["Authorization header name"] %>" name="GeneralRequestItem.AuthorizationHeader.Key" value="Authorization" style="<%= readonlyStyle %>"><input readonly id="generalAuthorizationValue" aria-label="<%= ui["Authorization header value"] %>" value="<%= g.AuthorizationHeader.Value %>" style="<%= readonlyStyle %>"><input type="hidden" id="generalAuthorizationHidden" name="GeneralRequestItem.AuthorizationHeader.Value" value="<%= g.AuthorizationHeader.Value %>"></div>
        <div class="generalPairRow" id="generalFormContentTypeHeader" style="width:610px;padding:4px 0;border-top:solid 1px #999;"><input readonly aria-label="<%= ui["Header name"] %>" value="Content-Type" style="<%= readonlyStyle %>"><input readonly id="generalFormContentType" aria-label="<%= ui["Header value"] %>" value="multipart/form-data; boundary=..." style="<%= readonlyStyle %>"></div>
        <div class="generalPairRow" id="generalUrlContentTypeHeader" style="width:610px;padding:4px 0;border-top:solid 1px #999;"><input readonly aria-label="<%= ui["Header name"] %>" value="Content-Type" style="<%= readonlyStyle %>"><input readonly id="generalUrlContentType" aria-label="<%= ui["Header value"] %>" value="application/x-www-form-urlencoded" style="<%= readonlyStyle %>"></div>
        <div class="generalPairRow" id="generalRawContentTypeHeader" style="width:610px;padding:4px 0;border-top:solid 1px #999;"><input readonly aria-label="<%= ui["Header name"] %>" value="Content-Type" style="<%= readonlyStyle %>"><input name="GeneralRequestItem.Body.RawContentType" value="<%= g.Body.RawContentType %>" style="width:280px;margin:auto 1px;" aria-label="<%= ui["Raw body content type"] %>"></div>
        <%- include('webhook-pairs',{wp,container:'generalHeaders',prefix:'GeneralRequestItem.Headers',pairs:g.Headers,hideHead:true}) %>
      </td></tr>
      <tr><th scope="row"><label for="GeneralRequestItem.Body.Type"><%= ui["Body"] %></label></th><td><select id="GeneralRequestItem.Body.Type" name="GeneralRequestItem.Body.Type" onchange="generalBodyChanged(this.value)"><% for(const [kind,label] of [['None',ui["Non"]],['FormData','form-data'],['XWwwFormURLEncoded','x-www-form-urlencoded'],['Raw','raw']]){ %><option value="<%= kind %>"<%- selected(g.Body.Type,kind) %>><%= label %></option><% } %></select>
        <div id="generalFormBody" style="margin-top:4px;"><%- include('webhook-pairs',{wp,container:'generalBodyItems',prefix:'GeneralRequestItem.Body.Items',pairs:g.Body.Items,hideHead:false}) %></div>
        <div id="generalRawBody" style="margin-top:4px;"><textarea rows="6" cols="78" name="GeneralRequestItem.Body.Raw" aria-label="<%= ui["Raw body"] %>"><%= g.Body.Raw %></textarea></div>
      </td></tr>
      <tr><th scope="row"><label for="RetryCount"><%= ui["Retry count"] %></label></th><td><select id="RetryCount" name="RetryCount"><% for(const count of wp.retryGeneral){ %><option value="<%= count %>"<%- selected(count,general.RetryCount) %>><%= count %></option><% } %></select></td></tr>
    </table>
    <p><input type="submit" class="image-ok_btn" value="Confirm" onclick="document.getElementById('generalWebhookAct').value=''"><a id="image-cancel_btn" class="image-cancel_label" href="<%= root %>/Details?mode=webhook&amp;act=edit&amp;id=<%= general.WebhookId %>"><%= ui["Cancel"] %></a></p>
  </div></div>
</form>
