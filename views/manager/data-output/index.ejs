<% const root = `${base}/DataOutput`; const selectedLabel = view === 'index' ? String(input.LabelID || 'All') : ''; %>
<script src="<%= base %>/Scripts/jquery.unobtrusive-ajax.min.js?20250901-01"></script>
<%- include('../shared/transfer-layout') %>
<div id="MessageWrap"><% if(error) { %><ul class="validation-summary-errors" role="alert"><li><%= error %></li></ul><% } %></div>
<div id="Wrap" class="manager-transfer-workspace<%= view === 'index' ? ' manager-index-workspace' : '' %>"><div id="SideWrap">
  <% if(view === 'index') { %><% if(kind === 'rep') { %><div id="BackIndex"><a href="<%= root %>?act=BACK_INDEX">BACK</a></div><% } %><div id="LabelSection"><%- include('../shared/transfer-labels', { selectedLabel, labelHref: `${root}${kind === 'rep' ? '/RepIndex' : ''}?act=BACK_INDEX&LabelID=` }) %></div>
  <% } else { %><div id="BackIndex"><a href="<%= root %>/<%= view === 'confirm' ? 'Details' : 'RepIndex' %>?act=BACK_INDEX">BACK</a></div><div id="LabelSection"><ul id="Labels" class="treeview"><% if(view === 'details') { for(const item of selection.layouts) { %><li><a class="<%= item.org === layout.org ? 'current' : '' %>" href="<%= root %>/Details?requestTopId=<%= item.org %>" onclick="outputLayoutSwitch(<%= item.org %>);return false;"><%= item.org %> <%= item.name %></a></li><% } } %></ul></div><% } %>
</div><div id="MainWrap"><div id="content">
<% if(view === 'index') { %>
  <form id="ConMasForm" method="post" action="<%= root %>/<%= kind === 'def' ? 'IndexList' : 'RepIndexList' %>">
    <input type="hidden" name="__RequestVerificationToken" value="<%= csrfToken %>"><input type="hidden" name="Act" id="Act"><input type="hidden" name="LabelID" value="<%= input.LabelID || '' %>"><input type="hidden" name="<%= kind === 'def' ? 'ChkDefTopID' : 'ChkRepTopID' %>" id="OutputSelection">
    <div id="Filters"><div class="manager-output-filter"><span id="infoTitle"><%= kind === 'def' ? 'Select forms for data output' : 'Select documents for data output' %></span><ul id="FiltersUl"><li><select name="PublicStatus" aria-label="Disclosure Status" onchange="outputPage(0)"><% for(const [key,title] of [['-1','All'],['0','Non-disclosure'],['1','Test'],['2','Published']]) { %><option value="<%= key %>" <%= String(input.PublicStatus || '-1') === key ? 'selected' : '' %>><%= title %></option><% } %></select></li><li><label><input type="checkbox" name="IsAllRevision" value="true" onchange="outputPage(0)" <%= input.IsAllRevision === 'true' ? 'checked' : '' %>>Displays history</label></li>
    <li><a class="img_search" aria-label="Search" title="Search" href="#SearchDialog" onclick="$('#SearchDialog').toggle();return false;"> </a></li><li><button type="button" class="img_next" onclick="outputNext()">Next</button></li></ul></div><% if(kind === 'def') { %><div class="manager-cooperation-row"><button type="button" class="img_next cooperation_view" onclick="window.location.href='<%= root %>/NextCooperationView'">To linkage view</button></div><% } %></div>
    <div id="SearchDialog" role="region" aria-label="Search" style="display:none;"><div class="DialogMargin"><div class="DialogTitle">Search<button type="button" class="DialogClose" aria-label="Close search" onclick="$('#SearchDialog').hide();"><img src="<%= base %>/Content/ConMas/images/function/close.png" alt=""></button></div>
      <div class="DialogLabel"><label for="SearchId">ID</label></div><div class="DialogField"><input type="text" id="SearchId" name="SearchId" value="<%= input.SearchId || '' %>"></div>
      <div class="DialogLabel"><label for="SearchName">Name</label></div><div class="DialogField"><input type="text" id="SearchName" name="SearchName" value="<%= input.SearchName || '' %>"></div>
      <p><label><input type="checkbox" name="IsLabelUnderSearch" value="true" <%= input.IsLabelUnderSearch === 'true' ? 'checked' : '' %>>Including label hierarchy</label></p>
      <div class="manager-actions"><button class="image-ok_btn">Search</button><button type="button" class="image-cancel_btn" onclick="$('#SearchDialog').hide();">Close</button></div>
    </div></div>
    <div id="IndexList"><%- include('list') %></div>
    <div class="manager-actions"><button type="button" class="button_custom" onclick="outputAction('ALL_UNSELECTED')">Clear your selections all.</button><% if(kind === 'rep') { %> <button type="button" class="button_custom" onclick="outputAction('ALL_SELECTED')">Select All</button><% } %></div>
  </form>
<% } else if(view === 'details') { %>
  <form id="ConMasOutputForm" method="post" action="<%= root %>/Details"><input type="hidden" name="__RequestVerificationToken" value="<%= csrfToken %>"><input type="hidden" name="outputSelectData.defTopId" value="<%= layout.org %>"><input type="hidden" name="requestDefTopId" value="<%= layout.org %>">
    <div id="DetailSection"><div class="info"><div class="manager-detail-heading"><span id="infoTitle">Please check items for data output.</span><button name="act" value="NEXT" class="img_next">Next</button></div>
      <div id="outputSaveContent"><button name="act" value="saveDefFieldLoad" class="tabButtonSelect" style="width:50%;">Data output setting in Manager</button><div class="manager-actions"><button name="act" value="saveDefField" class="conmas_link_button_custom" style="padding:5px;margin:5px;width:100px;">Save</button> <button name="act" value="saveDefFieldClear" class="conmas_link_button_black" style="padding:5px;margin:5px;">Clear</button></div></div>
      <div class="toggle"><h2><button type="button" class="manager-section-toggle" aria-expanded="true" aria-controls="basicInfomation">Basic information</button></h2></div>
      <div id="basicInfomation" class="manager-grid-scroll"><table class="table_information verticality"><tr><th style="width:30px;">No</th><th class="checkCol"><input type="checkbox" aria-label="Select all document fields" onclick="$(this).closest('table').find('input[name=TopFields]').prop('checked',this.checked)"></th><th>Item name</th></tr><% for(const [i,field] of topFields.entries()) { %><tr><td class="RightCol"><%= i+1 %></td><td class="CenterCol"><input id="<%= field %>" type="checkbox" name="TopFields" value="<%= field %>" <%= layout.fields.includes(field) ? 'checked' : '' %>></td><td><label for="<%= field %>"><%= fieldLabels[field] %></label></td></tr><% } %></table></div>
      <% for(const sheet of layout.sheets) { %>
      <div class="toggle"><h2><button type="button" class="manager-section-toggle" aria-expanded="true" aria-controls="outputSheet_<%= sheet.org %>">Sheet information <%= sheet.org %></button></h2></div><div id="outputSheet_<%= sheet.org %>">
        <div class="manager-grid-scroll"><table class="table_information verticality"><tr><th>No.</th><th class="checkCol"><input type="checkbox" aria-label="Select all sheet <%= sheet.org %> fields" onclick="$(this).closest('table').find('input[name=SheetFields_<%= sheet.org %>]').prop('checked',this.checked)"></th><th>Sheet information</th></tr><% for(const [i,field] of sheetFields.entries()) { %><tr><td class="CenterCol"><%= i+1 %></td><td class="CenterCol"><input id="<%= field %>_<%= sheet.org %>" type="checkbox" name="SheetFields_<%= sheet.org %>" value="<%= field %>" <%= sheet.fields.includes(field) ? 'checked' : '' %>></td><td><label for="<%= field %>_<%= sheet.org %>"><%= fieldLabels[field] %></label></td></tr><% } %></table></div>
        <div class="manager-grid-scroll" tabindex="0" role="region" aria-label="Sheet <%= sheet.org %> clusters"><table class="table_information verticality"><tr><th style="width:30px;">No</th><th class="checkCol">Output</th><th style="width:250px;">Input value / Displayed value</th><th>Cluster name</th></tr><% for(const [i,cluster] of sheet.clusters.entries()) { %><tr><td class="RightCol"><%= i+1 %></td><td class="CenterCol"><input type="checkbox" aria-label="Output <%= cluster.name %>" name="Cluster_<%= sheet.org %>_<%= cluster.id %>" value="true" <%= cluster.selected ? 'checked' : '' %>></td><td><label><input type="radio" name="Display_<%= sheet.org %>_<%= cluster.id %>" value="false" <%= !cluster.display ? 'checked' : '' %>>Input value</label><label><input type="radio" name="Display_<%= sheet.org %>_<%= cluster.id %>" value="true" <%= cluster.display ? 'checked' : '' %>>Displayed value</label></td><td><%= cluster.name %></td></tr><% } %></table></div>
      </div><% } %>
      <div class="toggle"><h2><button type="button" class="manager-section-toggle" aria-expanded="true" aria-controls="clusterDetailSetting">Output setting for cluster details.</button></h2></div><div id="clusterDetailSetting"><label><input type="checkbox" name="IsClusterDetails" value="true" <%= layout.clusterDetails ? 'checked' : '' %>>Output cluster detailed information.</label></div><div class="manager-actions"><button name="act" value="NEXT" class="img_next">Next</button> <button name="act" value="BACK_INDEX" class="image-cancel_btn">BACK</button></div>
    </div></div>
  </form>
<% } else if(view === 'confirm') { %>
   <div id="DetailSection"><div class="info"><div id="infoTitle">Confirmation</div><form method="post" class="manager-actions" action="<%= root %>/OutputCsv"><input type="hidden" name="__RequestVerificationToken" value="<%= csrfToken %>"><button class="img_output_csv">OUTPUT</button></form><% for(const preview of previews) { %><h2><%= preview.name %></h2><div style="font-weight:bold;">Preview</div><div class="preview_box manager-grid-scroll" tabindex="0" role="region" aria-label="<%= preview.name %> CSV preview"><table class="table_information manager-csv-preview" cellspacing="0"><% for(const [i,row] of preview.rows.entries()) { %><tr><% for(const value of row) { if(i === 0) { %><th><%= value %></th><% } else { %><td><%= value %></td><% } } %></tr><% } %></table></div><% } %>
   </div></div>
<% } else if(view === 'info') { %><div id="DetailSection"><div class="info"><div id="infoTitle">Information</div><table class="table_information horizontal"><% for(const [key,title] of [['id','ID'],['name','Form name'],['rev_no','REV'],['public_status','Disclosure Status'],['sys_regist_user','Registrant'],['sys_regist_time','Registration date and time'],['sys_update_user','Last updated by'],['sys_update_time','Last update date and time']]) { const value=row[key]; %><tr><th scope="row"><%= title %></th><td><%= value instanceof Date ? value.toISOString().slice(0,16).replace('T',' ').replaceAll('-','/') : value %></td></tr><% } %></table></div></div>
<% } else { %><p><a href="<%= root %>/Details">Back to output settings</a> <a href="<%= root %>?act=BACK_INDEX">Back to forms</a></p><% } %>
</div></div></div>
<script>
function outputDelta(){ return $('.output-select').map(function(){return this.value+':'+this.checked;}).get().join(','); }
function outputLayoutSwitch(org){var form=document.getElementById('ConMasOutputForm');form.elements.requestDefTopId.value=org;var action=document.createElement('input');action.type='hidden';action.name='act';action.value='link';form.appendChild(action);form.submit();}
function outputAction(action){$('#Act').val(action);$('#OutputSelection').val(outputDelta());$('#ConMasForm').trigger('submit');}
function outputPage(index){$('#PageIndex').val(index);outputAction('PAGE');}
function outputSort(column){$('#SortDirection').val($('#SortColumn').val()===column&&$('#SortDirection').val()==='ASC'?'DESC':'ASC');$('#SortColumn').val(column);outputPage(0);}
function outputNext(){window.location.href='<%= root %>/<%= view === 'index' && kind === 'def' ? 'NextDetails' : 'NextSelectDetails' %>?topIds='+encodeURIComponent(outputDelta());}
$(function(){$('#ConMasForm').on('submit',function(e){e.preventDefault();var form=$(this);$('#OutputSelection').val(outputDelta());$.ajax({url:form.attr('action'),type:'POST',data:form.serialize(),success:function(html){$('#IndexList').html(html);},error:function(xhr){$('#MessageWrap').text(xhr.status===403?'Role authority is insufficient.':'Request failed.');},complete:function(){$('#Act').val('');}});});});
</script>
