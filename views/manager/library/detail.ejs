<% const editable = create || edit; const value = key => document[key] ?? ''; const date = value => value ? new Date(value).toISOString().slice(0,10).replaceAll('-','/') : ''; %>
<% if (!editable && permissions.edit && view !== 'info') { %><div style="text-align:right;"><a class="img_edit2" title="Edit" aria-label="Edit" href="<%= root %>/Details?documentId=<%= document.document_id %>&mode=<%= mode %>&detailsMode=Edit&isFirst=true"> </a></div><% } %>
<form id="conmasDocumentForm" method="post" enctype="multipart/form-data" action="<%= root %>/Details">
<input type="hidden" name="__RequestVerificationToken" value="<%= csrfToken %>"><input type="hidden" name="mode" value="<%= mode %>"><input type="hidden" name="DetailsMode" value="<%= create ? 'Create' : edit ? 'Edit' : 'Search' %>"><input type="hidden" name="Document.document_id" value="<%= document.document_id %>">
<% if (!editable && value('document_type') === 'PDF' && Number(document.document_save_kbn) !== 1) { %><div class="manager-pdf-preview"><embed src="<%= root %>/GetPdf?documentId=<%= document.document_id %>" type="application/pdf" title="PDF preview" width="100%" height="100%"></div><% } %>
<% if (editable) { %><div class="manager-actions"><button class="image-ok_btn" type="submit">Confirm</button><button class="image-cancel_btn" type="submit" onclick="this.form.elements.act.value='EDIT_CANCEL'">Cancel</button></div><% } %>
<div class="toggle"><h2><button type="button" class="manager-section-toggle" aria-expanded="true" aria-controls="documentInfo">Information</button></h2></div>
<% if (create) { %><p>Multiple documents can be uploaded at once.</p><% } %>
<div id="documentInfo"><table class="table_information horizontal" cellspacing="0">
  <% if(!create) { %><tr><th>ID</th><td><%= document.document_id %></td></tr><% } %>
  <tr <% if(create) { %>data-library-storage="1,2" <%= Number(document.document_save_kbn)===0 ? 'hidden' : '' %><% } %>><th><label for="Document_document_name">Name</label></th><td><% if(editable) { %><input type="text" id="Document_document_name" name="Document.document_name" value="<%= value('document_name') %>" style="width:90%;"><% } else { %><%= value('document_name') %><% } %></td></tr>
  <% if (!editable) { %><tr><th>Original file name</th><td><%= value('document_name_org') %></td></tr><% } %>
  <tr <%= mode === 'ImageLib' ? 'hidden' : '' %>><th>Type of storage</th><td><% if(editable) { for(const [key,title] of [[0,'File system'],[1,'URL'],...(mode === 'ComLIb' ? [[2,'IRFD File']] : [])]) { if(mode === 'ImageLib' && key !== 0) continue; %><label><input type="radio" name="Document.document_save_kbn" value="<%= key %>" <%= Number(document.document_save_kbn)===key ? 'checked' : '' %>><%= title %></label><% } } else { %><%= ['File system','URL','IRFD File'][Number(document.document_save_kbn)] %><% } %></td></tr>
  <tr <% if (mode === 'ImageLib') { %>hidden<% } else if (create) { %>data-library-storage="1" <%= Number(document.document_save_kbn)!==1 ? 'hidden' : '' %><% } %>><th>Icon</th><td><% if(editable) { %><span data-library-storage="0" <%= Number(document.document_save_kbn)===0 ? '' : 'hidden' %>><select name="Document.document_type" aria-label="File icon"><% for(const type of referenceTypes.filter(type=>type!=='URL' && (mode==='RepLIb' || type!=='AIModel'))) { %><option <%= value('document_type')===type ? 'selected' : '' %>><%= type %></option><% } %></select></span><span data-library-storage="1" <%= Number(document.document_save_kbn)===1 ? '' : 'hidden' %>><select name="Document.document_type_url" aria-label="URL icon"><% for(const type of referenceTypes.filter(type=>mode==='RepLIb'||type!=='AIModel')) { %><option <%= (value('document_type')||'URL')===type ? 'selected' : '' %>><%= type %></option><% } %></select></span><% } else { %><%= value('document_type') %><% } %></td></tr>
  <% for(const [key,title] of [['document_mobile_save','Availability to save on tablet'],['IsOtherAppOpen','Allow to open the file by another application.']]) { const val=Number(key === 'IsOtherAppOpen' ? value('is_other_app_open') : value(key)); %><tr <% if(key === 'document_mobile_save') { %>data-library-storage="0,2" <%= Number(document.document_save_kbn)===1 ? 'hidden' : '' %><% } else if (mode === 'ImageLib') { %>hidden<% } %>><th><%= title %></th><td><% if(editable) { for(const [n,text] of [[1,'Yes'],[0,'No']]) { %><label><input type="radio" name="Document.<%= key %>" value="<%= n %>" <%= val===n ? 'checked' : '' %>><%= text %></label><% } } else { %><%= key === 'document_mobile_save' ? val===1 ? 'Available' : 'Not available' : val===1 ? 'Yes' : 'No' %><% } %></td></tr><% } %>
  <tr <% if(mode === 'RepLIb') { %>hidden<% } else { %>data-library-storage="0,2" <%= Number(document.document_save_kbn)===1 ? 'hidden' : '' %><% } %>><th>Download manually</th><td><% if(editable) { %><input type="checkbox" aria-label="Download manually" name="Document.document_manual_download" value="true" <%= Number(value('document_manual_download'))===1 ? 'checked' : '' %>><% } else { %><%= Number(value('document_manual_download'))===1 ? 'Valid' : 'Invalid' %><% } %></td></tr>
  <tr <% if(mode === 'RepLIb') { %>hidden<% } else { %>data-library-storage="0,2" <%= Number(document.document_save_kbn)===1 ? 'hidden' : '' %><% } %>><th>Term of valid on tablet</th><td><% const minutes=Number(value('document_life_time'))||0; if(editable) { for(const [key,val,title] of [['day',Math.floor(minutes/1440),'Day'],['hour',Math.floor(minutes%1440/60),'Time'],['minuite',minutes%60,'Minutes']]) { %><input aria-label="<%= title %>" name="Document.document_life_time_<%= key %>" value="<%= val %>" style="width:40px;text-align:right;"><%= title %><% } } else if (Number(value('document_manual_download'))===1 && minutes) { %><%= Math.floor(minutes/1440) %> day(s) <%= Math.floor(minutes%1440/60) %> hour(s) <%= minutes%60 %> minute(s)<% } %></td></tr>
  <tr><th><label for="Document_use_end_time">Expire date</label></th><td><% if(editable) { %><input type="text" data-manager-date id="Document_use_end_time" name="Document.use_end_time" value="<%= date(value('use_end_time')) %>" placeholder="yyyy/MM/dd"><% } else { %><%= date(value('use_end_time')) %><% } %></td></tr>
  <tr><th><span data-library-storage="0,2" <%= Number(document.document_save_kbn)===1 ? 'hidden' : '' %>>File</span><span data-library-storage="1" <%= Number(document.document_save_kbn)!==1 ? 'hidden' : '' %>>URL</span></th><td><% if(editable) { %><div id="fileSystemDocumentBox" data-library-storage="0" <%= Number(document.document_save_kbn)===0 ? '' : 'hidden' %>><% if(!create && !draft.files.length && value('document_name_org')) { %><div><a href="<%= root %>/GetDocument?documentId=<%= document.document_id %>"><%= value('document_name_org') %></a></div><% } %><input type="file" name="fileDocs" <%= mode === 'ImageLib' ? 'accept=.jpeg,.jpg,.png,.tif,.tiff' : '' %> <%= create ? 'multiple' : '' %> aria-label="Upload file"><div id="uploadFiles"><% for(const file of draft.files) { %><div><a href="<%= root %>/GetDocument?tempFullFileName=<%= file.token %>"><%= file.name %></a> <button name="DeleteObjectId" value="<%= file.token %>" onclick="this.form.elements.act.value='FILE_DELETE'">Remove</button></div><% } %></div></div><div id="urlDocumentBox" data-library-storage="1" <%= Number(document.document_save_kbn)===1 ? '' : 'hidden' %>><label>URL <input type="text" name="Document.document_path" value="<%= value('document_path') %>" style="width:90%;"></label></div>
    <% } else if(Number(document.document_save_kbn) === 1) { %><%= value('document_path') %><% } else { %><a href="<%= root %>/GetDocument?documentId=<%= document.document_id %>"><%= value('document_name_org') || value('document_name') %></a><% if(mode === 'ImageLib') { %><div><img src="<%= root %>/GetFreeDrawImageThumbnail?documentId=<%= document.document_id %>&customSize=200" alt="<%= value('document_name') %>"></div><% } } %></td></tr>
  <tr><th><label for="Document_Remarks">Remarks</label></th><td><% if(editable) { %><textarea id="Document_Remarks" name="Document.Remarks" style="width:90%;"><%= value('remarks') %></textarea><% } else { %><pre class="manager-remarks"><%= value('remarks') %></pre><% } %></td></tr>
  <% if(!create) { for(const [key,title] of [['sys_regist_user','Registrant'],['sys_regist_time','Registration date and time'],['sys_update_user','Last updated by'],['sys_update_time','Last update date and time']]) { %><tr><th><%= title %></th><td><%= key.endsWith('time') ? dateText(value(key)) : value(key) %></td></tr><% } } %>
</table></div>
<div class="toggle"><h2><button type="button" class="manager-section-toggle" aria-expanded="true" aria-controls="labelInfo">Labels</button></h2></div>
<div id="labelInfo"><table class="table_information verticality"><tr><th>Labels</th></tr><% for(const label of labels) { %><tr><td><label><input type="checkbox" name="LabelIds" value="<%= label.mst_label_id %>" <%= attached.includes(label.mst_label_id) ? 'checked' : '' %> <%= editable ? '' : 'disabled' %>><%= label.label_name_path %></label></td></tr><% } %></table></div>
<% if(create) { %><%- include('role-fields') %><% } %>
<% if(editable) { %><input type="hidden" name="act" value="SAVE"><div class="manager-actions"><button class="image-ok_btn" type="submit">Confirm</button> <button class="image-cancel_btn" type="submit" onclick="this.form.elements.act.value='EDIT_CANCEL'">Cancel</button></div><% } %>
</form>
<script>
  $(function () {
    $('#conmasDocumentForm').on('change', 'input[name="Document.document_save_kbn"]', function () {
      var storage = this.value;
      $('[data-library-storage]').each(function () { this.hidden = this.getAttribute('data-library-storage').split(',').indexOf(storage) < 0; });
    });
  });
</script>
