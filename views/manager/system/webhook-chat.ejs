<div class="PartialViewMessage"><% if(wp.error){ %><ul><li><%= wp.error %></li></ul><% } %></div>
<input type="hidden" id="webhookId" name="webhookId" value="<%= setting.webhook_id %>">
<div id="DetailTop"><span id="infoTitle">Webhook notice setting</span></div>
<div id="DetailSection"><div class="info">
  <div class="toggle" role="button" tabindex="0" aria-expanded="true" aria-controls="webhookSetting" onclick="webhookToggle(this,'webhookSetting')" onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();webhookToggle(this,'webhookSetting')}"><h2 style="margin-top:5px;margin-bottom:10px;">▼Application linkage setting</h2></div>
  <div id="webhookSetting">
    <div style="text-align:right;padding-bottom:5px;"><% if(wp.canSystemEdit){const useGeneral=setting.webhook_id===-1||setting.webhook_to==='General'; %><a class="img_edit" href="<%= root %>/<%= useGeneral ? 'EditWebhookSettingGeneral' : 'EditWebhookSetting' %>?id=<%= setting.webhook_id %>" title="Edit" aria-label="Edit application linkage setting"> </a><% } %></div>
    <table style="padding:0;border-spacing:0;border-collapse:collapse;" class="table_information horizontal">
      <tr><th scope="row">Webhook notification address</th><td><%= wp.targetName(setting.webhook_to) %></td></tr>
      <% const isGeneral=setting.webhook_id!==-1&&setting.webhook_to==='General'; %>
      <tr><th scope="row"><%= isGeneral ? 'Name of webhook' : 'Webhook notification setting name' %></th><td><%= setting.webhook_name %></td></tr>
      <tr><th scope="row"><%= isGeneral ? 'Endpoint (URL)' : 'Webhook URL' %></th><td><%= setting.webhook_url %></td></tr>
      <tr><th scope="row"><%= isGeneral ? 'HTTP Method' : 'Webhook request' %></th><td><%= setting.webhook_request %></td></tr>
      <% if(isGeneral){const request=setting.GeneralRequestItem,auth=request.Authentication,body=request.Body;const params=request.Params.filter(item=>item.Key||item.Value); %>
        <% if(!params.length){ %><tr><th scope="row">Params</th><td>Non</td></tr><% }else{for(let i=0;i<params.length;i++){ %><tr><% if(i===0){ %><th scope="row" rowspan="<%= params.length %>">Params</th><% } %><td><%= params[i].Key %>：<%= params[i].Value %></td></tr><% }} %>
        <tr><th scope="row">Authentication</th><td><% if(auth.Type==='BasicAuth'){ %><span style="margin-right:12px;">Basic authentication</span><span>User name : <%= auth.Username %></span><% }else if(auth.Type==='BearerToken'){ %><span style="margin-right:12px;">Bearer authentication</span><span>Token : <%= auth.Token %></span><% }else{ %>Non<% } %></td></tr>
        <% const headers=[...(request.AuthorizationHeader.Key&&request.AuthorizationHeader.Value?[request.AuthorizationHeader]:[]),...(body.Type==='FormData'?[{Key:'Content-Type',Value:'multipart/form-data; boundary=...'}]:body.Type==='XWwwFormURLEncoded'?[{Key:'Content-Type',Value:'application/x-www-form-urlencoded'}]:body.Type==='Raw'?[{Key:'Content-Type',Value:body.RawContentType}]:[]),...request.Headers.filter(item=>item.Key||item.Value)]; %>
        <% if(!headers.length){ %><tr><th scope="row">Headers</th><td>Non</td></tr><% }else{for(let i=0;i<headers.length;i++){ %><tr><% if(i===0){ %><th scope="row" rowspan="<%= headers.length %>">Headers</th><% } %><td><%= headers[i].Key %>：<%= headers[i].Value %></td></tr><% }} %>
        <tr><th scope="row">Body</th><td><% if(body.Type==='Raw'){ %><span style="margin-right:12px;">raw</span><table style="padding:0;border-spacing:0;border-collapse:collapse;margin-top:4px;margin-bottom:auto;margin-left:20px;" class="table_information horizontal"><tr><td><span style="white-space:pre-wrap;"><%= body.Raw %></span></td></tr></table><% }else if(['FormData','XWwwFormURLEncoded'].includes(body.Type)){ %><span style="margin-right:12px;"><%= body.Type==='FormData'?'form-data':'x-www-form-urlencoded' %></span><% if(body.Items.length){ %><table style="padding:0;border-spacing:0;border-collapse:collapse;margin-top:4px;margin-bottom:auto;margin-left:20px;" class="table_information horizontal"><% for(const item of body.Items){ %><tr><td><%= item.Key %> : <%= item.Value %></td></tr><% } %></table><% } %><% }else{ %>Non<% } %></td></tr>
      <% }else{ %>
        <% const params=setting.webhook_id===-1 ? [] : setting.webhookParams; if(!params.length){ %><tr><th scope="row">Webhook parameter</th><td></td></tr><% }else{for(let i=0;i<params.length;i++){ %><tr><th scope="row"><% if(i===0){ %>Webhook parameter<% }else{ %>&nbsp;<% } %></th><td><%= wp.parameterName(params[i].paramType) %>：<%= params[i].paramContent %></td></tr><% }} %>
        <tr><th scope="row">Token</th><td><%= setting.token %></td></tr>
      <% } %>
      <tr><th scope="row">Retry count</th><td><%= setting.retry_cnt %></td></tr>
      <% if(!isGeneral){ %><tr style="display:none;"><th scope="row">When  error occurs</th><td><%= setting.error_occur %></td></tr><% } %>
    </table>
  </div>
  <div class="toggle" role="button" tabindex="0" aria-expanded="true" aria-controls="webhookNotification" onclick="webhookToggle(this,'webhookNotification')" onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();webhookToggle(this,'webhookNotification')}"><h2 style="margin-bottom:10px;">▼Notification Settings</h2></div>
  <div id="webhookNotification">
    <div style="text-align:right;padding-bottom:5px;"><% if(wp.canSystemEdit){ %><a class="img_edit" href="<%= root %>/EditWebhookNotification?id=<%= setting.webhook_id %>" title="Edit" aria-label="Edit notification settings" onclick="return webhookIsLinked(<%= setting.webhook_id %>)"> </a><% } %></div>
    <table style="padding:0;border-spacing:0;border-collapse:collapse;" class="table_information horizontal"><% for(const [key,label] of notifyNames){ %><tr><th scope="row"><%= label %></th><td><%= setting[key] ? 'Notification' : 'Without notification' %></td></tr><% } %></table>
  </div>
</div></div>
